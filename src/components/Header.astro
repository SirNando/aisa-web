---
import { Image } from "astro:assets";
import logo from "../assets/aisa-logo.png";

const pathname = Astro.url.pathname;
const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Familias y Escuelas", href: "/familias-y-escuelas/" },
  { label: "Acerca de", href: "/acerca-de/" },
];

const professionalLinks = [
  { label: "Profesionales", href: "/profesionales/" },
  { label: "Formación y cursos", href: "/profesionales/formacion-y-cursos/" },
  { label: "Certificación", href: "/profesionales/certificacion/" },
  { label: "Asociate", href: "/profesionales/#solicitud" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href.includes("#")) return false;
  return pathname.startsWith(href);
};

const professionalsActive = pathname.startsWith("/profesionales") || pathname.startsWith("/buscar-profesional");
---

<header class="site-header" data-site-header transition:persist="site-header">
  <div class="site-header__shell">
    <a class="site-header__brand" href="/" aria-label="AISA Argentina, inicio">
      <Image src={logo} alt="AISA Argentina" width={176} height={60} loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      {
        navItems.slice(0, 2).map((item) => (
          <a
            class="site-nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <div class="site-nav__group">
        <a
          class="site-nav__toggle"
          href="/profesionales/"
          aria-current={professionalsActive ? "page" : undefined}
        >
          Profesionales
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="site-nav__dropdown">
          {professionalLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      {
        navItems.slice(2).map((item) => (
          <a
            class="site-nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a class="button-secondary" href="/contacto/">Contacto</a>
      <a class="button-primary" href="/buscar-profesional/">Buscar profesional</a>
    </div>

    <button
      class="site-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
      data-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" data-menu-icon />
      </svg>
    </button>

    <div class="mobile-nav" id="mobile-menu" data-mobile-menu hidden>
      <div class="mobile-nav__actions">
        <a class="button-primary" href="/buscar-profesional/">Buscar profesional</a>
        <a class="button-secondary" href="/profesionales/#solicitud">Asociate</a>
      </div>
      <nav aria-label="Navegación móvil">
        {
          navItems.slice(0, 2).map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))
        }
        <a href="/profesionales/" aria-current={professionalsActive ? "page" : undefined}>Profesionales</a>
        <div class="mobile-nav__subnav">
          {professionalLinks.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        {navItems.slice(2).map((item) => <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
        <a href="/contacto/" aria-current={pathname.startsWith("/contacto") ? "page" : undefined}>Contacto</a>
      </nav>
    </div>
  </div>
</header>
