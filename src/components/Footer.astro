---
import ArrowLink from "./design-system/ArrowLink.astro";

const year = new Date().getFullYear();
const email = "integracion.sensorialargentina@gmail.com";
---

<footer id="aisa" class="site-footer" data-site-footer>
  <div class="site-container site-footer__main">
    <div class="site-footer__brand" data-reveal>
      <h2>AISA Argentina</h2>
      <p>
        Una asociación sin fines de lucro que reúne a terapistas ocupacionales
        especializados en Integración Sensorial.
      </p>
      <ArrowLink
        href={`mailto:${email}?subject=Consulta%20desde%20el%20sitio%20de%20AISA`}
        label="Contactate con nosotros"
      />
    </div>

    <nav class="site-footer__links" aria-label="Navegación del pie" data-reveal-group>
      <div class="site-footer__column" data-reveal-item>
        <h3>Explorá AISA</h3>
        <ul>
          <li><a href="/acerca-de/">Acerca de AISA</a></li>
          <li><a href="/familias-y-escuelas/">Familias y escuelas</a></li>
          <li><a href="/profesionales/">Profesionales</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>

      <div class="site-footer__column" data-reveal-item>
        <h3>Próximos pasos</h3>
        <ul>
          <li><a href="/buscar-profesional/">Buscar profesional</a></li>
          <li><a href="/profesionales/formacion-y-cursos/">Formación y cursos</a></li>
          <li><a href="/profesionales/certificacion/">Certificación</a></li>
          <li><a href="/profesionales/#solicitud">Cómo asociarte</a></li>
        </ul>
      </div>

      <div class="site-footer__column" data-reveal-item>
        <h3>AISA en línea</h3>
        <ul>
          <li><a href="https://www.instagram.com/aisa_argentina/?hl=es" rel="noreferrer">Instagram</a></li>
          <li><a href="https://www.youtube.com/channel/UCeTP2z-Rt7LlbwQlChQRb6g" rel="noreferrer">YouTube</a></li>
          <li><a href="https://www.facebook.com/AsociacionDeIntegracionSensorialArgentina/" rel="noreferrer">Facebook</a></li>
          <li><a href={`mailto:${email}`}>Correo electrónico</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="site-footer__bottom">
    <div class="site-container site-footer__bottom-inner">
      <span>© {year} AISA Argentina</span>
      <span>Información institucional y orientación general.</span>
    </div>
  </div>
</footer>
