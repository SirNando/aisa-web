---
import "maplibre-gl/dist/maplibre-gl.css";
---

<div
  class="directory-map"
  data-directory-map
  aria-label="Mapa interactivo de consultorios en Argentina"
>
  <div class="directory-map__canvas">
    <div
      class="directory-map__canvas-surface"
      data-directory-map-canvas
    ></div>
  </div>

  <div class="directory-map__loading" data-map-loading role="status">
    Cargando el mapa…
  </div>

  <div class="directory-map__filter-panel">
    <slot name="filters" />
  </div>

  <article
    class="directory-map__popup"
    data-map-popup
    hidden
    aria-live="polite"
  >
    <button
      class="directory-map__popup-close"
      type="button"
      data-map-popup-close
      aria-label="Cerrar detalle"
    >
      <span aria-hidden="true">×</span>
    </button>
    <p data-map-popup-location></p>
    <h3 data-map-popup-name></h3>
    <dl class="directory-map__popup-contact">
      <div data-map-popup-phone-row>
        <dt>Teléfono</dt>
        <dd data-map-popup-phone></dd>
      </div>
      <div data-map-popup-email-row>
        <dt>Email</dt>
        <dd data-map-popup-email></dd>
      </div>
    </dl>
  </article>
</div>
