---
interface Props {
  href: string;
  label: string;
  className?: string;
  external?: boolean;
}

const { href, label, className, external = false } = Astro.props;
---

<a
  class:list={["arrow-link", className]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  <span>{label}</span>
  <span class="arrow-link__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
      <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
