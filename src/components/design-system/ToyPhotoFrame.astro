---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PlayfulTone } from "../../lib/playfulArtwork";

interface Props {
  src: ImageMetadata;
  secondarySrc: ImageMetadata;
  alt: string;
  aspect?: "portrait" | "landscape" | "square";
  tone?: PlayfulTone;
  objectPosition?: "center" | "top" | "left" | "right";
  loading?: "eager" | "lazy";
  sizes?: string;
  className?: string;
}

const {
  src,
  secondarySrc,
  alt,
  aspect = "landscape",
  tone = "leaf",
  objectPosition = "center",
  loading = "lazy",
  sizes = "(min-width: 64rem) 38vw, 92vw",
  className,
} = Astro.props;
---

<figure
  class:list={[
    "toy-photo-frame",
    `toy-photo-frame--${aspect}`,
    `toy-photo-frame--${tone}`,
    `toy-photo-frame--focus-${objectPosition}`,
    className,
  ]}
  data-toy-photo-frame
>
  <span class="toy-photo-frame__panel-motion toy-photo-frame__panel-motion--one" data-parallax="-0.08">
    <span class="toy-photo-frame__panel toy-photo-frame__panel--one">
      <span class="toy-photo-frame__media" data-parallax-media>
        <Image
          src={src}
          alt={alt}
          widths={[360, 540, 720, 960]}
          sizes={sizes}
          loading={loading}
        />
      </span>
    </span>
  </span>
  <span class="toy-photo-frame__panel-motion toy-photo-frame__panel-motion--two" data-parallax="0.08" aria-hidden="true">
    <span class="toy-photo-frame__panel toy-photo-frame__panel--two">
      <span class="toy-photo-frame__media" data-parallax-media>
        <Image
          src={secondarySrc}
          alt=""
          widths={[360, 540, 720, 960]}
          sizes={sizes}
          loading={loading}
        />
      </span>
    </span>
  </span>
  <span class="toy-photo-frame__dot toy-photo-frame__dot--one" aria-hidden="true"></span>
  <span class="toy-photo-frame__dot toy-photo-frame__dot--two" aria-hidden="true"></span>
</figure>
