---
import ArrowLink from "./ArrowLink.astro";

interface Props {
  title: string;
  body: string;
  href: string;
  linkText: string;
  embedUrl?: string;
  videoTitle?: string;
}

const {
  title,
  body,
  href,
  linkText,
  embedUrl,
  videoTitle = "Video de AISA Argentina",
} = Astro.props;
---

<section class="media-feature section-space" data-featured-media>
  <div class="site-container">
    <article class="media-feature__card" data-reveal>
      <div class="media-feature__video" data-parallax-media>
        {
          embedUrl ? (
            <iframe
              src={embedUrl}
              title={videoTitle}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          ) : (
            <slot name="media" />
          )
        }
      </div>
      <div class="media-feature__copy">
        <h2>{title}</h2>
        <p>{body}</p>
        <ArrowLink href={href} label={linkText} />
      </div>
    </article>
  </div>
</section>
