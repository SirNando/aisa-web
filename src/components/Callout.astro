---
import ArrowLink from "./design-system/ArrowLink.astro";
import OrganicShapes from "./design-system/OrganicShapes.astro";

interface Props {
  title: string;
  body: string;
  href: string;
  linkText: string;
  tone?: "sky" | "leaf" | "sand" | "green" | "dark";
  motionKey?: string;
}

const { title, body, href, linkText, tone = "leaf", motionKey } = Astro.props;
const shapeTone = tone === "green" || tone === "dark" ? "inverse" : tone;
const hasVisual = Astro.slots.has("visual");
---

<aside
  class:list={[
    "callout-card",
    `callout-card--${tone}`,
    hasVisual && "callout-card--with-visual",
  ]}
  data-reveal
  data-motion={motionKey}
>
  {
    !hasVisual && (
      <OrganicShapes variant="cluster" tone={shapeTone} className="callout-card__shapes" />
    )
  }
  <div class="callout-card__copy">
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <ArrowLink href={href} label={linkText} className="callout-card__action" />
  {
    hasVisual && (
      <div class="callout-card__visual">
        <slot name="visual" />
      </div>
    )
  }
</aside>
