---
import ArrowLink from "./design-system/ArrowLink.astro";

interface Props {
  title: string;
  body: string;
  href: string;
  linkText: string;
  tone?: "white" | "sky" | "leaf" | "sand" | "dark";
  number?: string;
  alignLinkBottom?: boolean;
}

const {
  title,
  body,
  href,
  linkText,
  tone = "white",
  number,
  alignLinkBottom = true,
} = Astro.props;
---

<article
  class:list={["journey-card", `journey-card--${tone}`]}
  data-reveal-item
  data-tilt-card
>
  <div>
    {number && <span class="journey-card__number">{number}</span>}
    <h3 class="journey-card__title">{title}</h3>
    <p class="journey-card__body">{body}</p>
  </div>
  <ArrowLink
    href={href}
    label={linkText}
    className={alignLinkBottom ? "journey-card__link" : undefined}
  />
</article>
