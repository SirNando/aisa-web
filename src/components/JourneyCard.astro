---
import ArrowLink from "./design-system/ArrowLink.astro";
import PlayfulObject from "./design-system/PlayfulObject.astro";
import type { PlayfulObjectKind, PlayfulTone } from "../lib/playfulArtwork";

interface Props {
  title: string;
  body: string;
  href: string;
  linkText: string;
  tone?: "white" | "sky" | "leaf" | "sand" | "dark";
  eyebrow?: string;
  alignLinkBottom?: boolean;
  featured?: boolean;
  compact?: boolean;
  illustration?: PlayfulObjectKind;
}

const {
  title,
  body,
  href,
  linkText,
  tone = "white",
  eyebrow,
  alignLinkBottom = true,
  featured = false,
  compact = false,
  illustration,
} = Astro.props;

const illustrationTone: PlayfulTone = tone === "dark"
  ? "inverse"
  : tone === "sky"
    ? "sky"
    : tone === "sand"
      ? "sand"
      : "leaf";
---

<article
  class:list={["journey-card", `journey-card--${tone}`, featured && "journey-card--featured", compact && "journey-card--compact"]}
  data-reveal-item
  data-tilt-card
  data-featured-card={featured ? "true" : undefined}
>
  {
    illustration && (
      <PlayfulObject
        kind={illustration}
        tone={illustrationTone}
        className="journey-card__illustration"
      />
    )
  }
  <div class="journey-card__tilt" data-tilt-surface>
    {eyebrow && <span class="journey-card__number">{eyebrow}</span>}
    <h3 class="journey-card__title">{title}</h3>
    <p class="journey-card__body">{body}</p>
  </div>
  <ArrowLink
    href={href}
    label={linkText}
    className={alignLinkBottom ? "journey-card__link stretched-card-link" : "stretched-card-link"}
  />
</article>
