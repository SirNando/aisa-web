---
const provinces = [
  "Ciudad Autónoma de Buenos Aires",
  "Buenos Aires",
  "Catamarca",
  "Chaco",
  "Chubut",
  "Córdoba",
  "Corrientes",
  "Entre Ríos",
  "Formosa",
  "Jujuy",
  "La Pampa",
  "La Rioja",
  "Mendoza",
  "Misiones",
  "Neuquén",
  "Río Negro",
  "Salta",
  "San Juan",
  "San Luis",
  "Santa Cruz",
  "Santa Fe",
  "Santiago del Estero",
  "Tierra del Fuego, Antártida e Islas del Atlántico Sur",
  "Tucumán",
];
---

<section
  id="solicitud"
  class="membership-section section-space scroll-mt-28"
  aria-labelledby="membership-title"
>
  <div class="site-container">
    <div class="membership-heading">
      <span class="membership-heading__line" aria-hidden="true"></span>
      <h2 id="membership-title">Asociate a AISA</h2>
      <p>
        Con este formulario daremos de alta tu perfil profesional y podrás
        acceder a nuestros recursos
      </p>
    </div>

    <form class="membership-form" data-membership-form novalidate>
      <header class="membership-form__header">
        <p class="required-note">
          <span aria-hidden="true">*</span> Campos obligatorios
        </p>
      </header>

      <ol class="form-progress" aria-label="Progreso del formulario">
        <li data-progress-step="0" aria-current="step">
          <span>1</span>Personales
        </li>
        <li data-progress-step="1"><span>2</span>Laborales</li>
        <li data-progress-step="2"><span>3</span>Formación</li>
        <li data-progress-step="3"><span>4</span>Práctica</li>
        <li data-progress-step="4"><span>5</span>Categoría</li>
      </ol>

      <div class="form-alert" data-form-alert role="alert" hidden></div>

      <fieldset class="form-panel" data-step-panel="0">
        <legend>Datos personales</legend>
        <p class="panel-intro">
          Contanos quién sos y cómo podemos contactarte.
        </p>

        <div class="field-grid field-grid--two">
          <label class="field">
            <span>Nombres <b aria-hidden="true">*</b></span>
            <input name="firstNames" autocomplete="given-name" required />
          </label>
          <label class="field">
            <span>Apellidos <b aria-hidden="true">*</b></span>
            <input name="lastNames" autocomplete="family-name" required />
          </label>
          <label class="field">
            <span
              >Provincia o lugar de nacimiento <b aria-hidden="true">*</b></span
            >
            <input name="birthPlace" autocomplete="off" required />
          </label>
          <label class="field">
            <span>Fecha de nacimiento <b aria-hidden="true">*</b></span>
            <input type="date" name="birthDate" autocomplete="bday" required />
          </label>
          <label class="field">
            <span>DNI <b aria-hidden="true">*</b></span>
            <input
              name="dni"
              inputmode="numeric"
              autocomplete="off"
              pattern="[0-9]{7,8}"
              maxlength="8"
              aria-describedby="dni-hint"
              required
            />
          </label>
          <label class="field">
            <span>Domicilio <b aria-hidden="true">*</b></span>
            <input name="homeAddress" autocomplete="street-address" required />
          </label>
          <label class="field">
            <span>Localidad <b aria-hidden="true">*</b></span>
            <input name="city" autocomplete="address-level2" required />
          </label>
          <label class="field">
            <span>Provincia <b aria-hidden="true">*</b></span>
            <select name="province" autocomplete="address-level1" required>
              <option value="">Seleccioná una provincia</option>
              {
                provinces.map((province) => (
                  <option value={province}>{province}</option>
                ))
              }
              <option value="Otra / exterior">Otra / exterior</option>
            </select>
          </label>
          <label class="field">
            <span>Código postal <b aria-hidden="true">*</b></span>
            <input
              name="postalCode"
              autocomplete="postal-code"
              maxlength="8"
              required
            />
          </label>
          <label class="field">
            <span>Teléfono fijo</span>
            <input type="tel" name="landline" autocomplete="tel-national" />
          </label>
          <label class="field">
            <span>Celular <b aria-hidden="true">*</b></span>
            <input type="tel" name="mobile" autocomplete="tel" required />
          </label>
          <label class="field">
            <span>Correo electrónico <b aria-hidden="true">*</b></span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="1" hidden>
        <legend>Datos laborales</legend>
        <p class="panel-intro">
          Ingresá los datos de tu ejercicio profesional y título de grado.
        </p>

        <div class="field-grid field-grid--two">
          <label class="field field--wide">
            <span>Domicilio profesional <b aria-hidden="true">*</b></span>
            <input
              name="professionalAddress"
              autocomplete="street-address"
              required
            />
          </label>
          <label class="field">
            <span>Teléfono profesional <b aria-hidden="true">*</b></span>
            <input type="tel" name="professionalPhone" required />
          </label>
          <label class="field">
            <span class="label-with-info">
              Profesión <b aria-hidden="true">*</b>
              <span class="info-wrap">
                <button
                  type="button"
                  class="info-button"
                  aria-label="Más información sobre profesión"
                  aria-expanded="false"
                  data-info-button>i</button
                >
                <span class="field-help" role="tooltip" data-info-content hidden
                  >Escribí la denominación exacta del título otorgado por la
                  entidad educativa; por ejemplo, “Licenciatura en Terapia
                  Ocupacional”.</span
                >
              </span>
            </span>
            <input name="profession" aria-label="Profesión" required />
          </label>
          <label class="field">
            <span
              >Universidad o entidad educativa <b aria-hidden="true">*</b></span
            >
            <input name="university" required />
          </label>
          <label class="field">
            <span>Año de egreso <b aria-hidden="true">*</b></span>
            <input
              type="number"
              name="graduationYear"
              inputmode="numeric"
              min="1950"
              max="2100"
              required
            />
          </label>
          <label class="field field--wide">
            <span>Número de matrícula <b aria-hidden="true">*</b></span>
            <input name="licenseNumber" required />
          </label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="2" hidden>
        <legend>
          <span class="label-with-info">
            Formación en Integración Sensorial
            <span class="info-wrap">
              <button
                type="button"
                class="info-button"
                aria-label="Más información sobre cursos de formación"
                aria-expanded="false"
                data-info-button>i</button
              >
              <span class="field-help" role="tooltip" data-info-content hidden
                >Cargá cada curso por separado. AISA solicitará los certificados
                para comprobar la formación teórica y práctica declarada.</span
              >
            </span>
          </span>
        </legend>
        <p class="panel-intro">
          Agregá los cursos a los que asististe. Si todavía no realizaste
          ninguno, podés continuar sin cargar este apartado.
        </p>

        <div class="course-list" data-course-list>
          <article class="course-entry" data-course-entry>
            <div class="course-entry__header">
              <h4 data-course-title>Curso 1</h4>
            </div>
            <div class="field-grid field-grid--two">
              <label class="field field--wide"
                ><span>Título del curso</span><input
                  name="courses[0][title]"
                  data-course-key="title"
                /></label
              >
              <label class="field"
                ><span>Disertante</span><input
                  name="courses[0][speaker]"
                  data-course-key="speaker"
                /></label
              >
              <label class="field"
                ><span>Año</span><input
                  type="number"
                  name="courses[0][year]"
                  min="1950"
                  max="2100"
                  inputmode="numeric"
                  data-course-key="year"
                /></label
              >
              <label class="field"
                ><span>Cantidad de horas</span><input
                  type="number"
                  name="courses[0][hours]"
                  min="0"
                  step="0.5"
                  inputmode="decimal"
                  data-course-key="hours"
                  data-course-hours
                /></label
              >
              <label class="field"
                ><span>Cátedra o institución organizadora</span><input
                  name="courses[0][chair]"
                  data-course-key="chair"
                /></label
              >
              <label class="field field--wide"
                ><span>Lugar</span><input
                  name="courses[0][place]"
                  data-course-key="place"
                /></label
              >
            </div>
          </article>
        </div>

        <div class="course-actions">
          <button
            type="button"
            class="button-secondary add-course"
            data-add-course
            ><span aria-hidden="true">＋</span> Agregar otro curso</button
          >
          <p><strong data-hours-total>0 horas</strong> de formación cargadas</p>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="3" hidden>
        <legend>Práctica clínica</legend>
        <p class="panel-intro">
          Esta información permite conocer tu experiencia y las condiciones de
          tu práctica actual.
        </p>

        <div class="field-grid field-grid--two">
          <label class="field">
            <span class="label-with-info">
              ¿Realizaste supervisiones clínicas o pasantías? <b
                aria-hidden="true">*</b
              >
              <span class="info-wrap">
                <button
                  type="button"
                  class="info-button"
                  aria-label="Más información sobre supervisiones clínicas o pasantías"
                  aria-expanded="false"
                  data-info-button>i</button
                >
                <span class="field-help" role="tooltip" data-info-content hidden
                  >Incluí experiencias de observación o práctica clínica
                  acompañadas por un profesional, aunque hayan formado parte de
                  una capacitación.</span
                >
              </span>
            </span>
            <select
              name="completedSupervision"
              aria-label="¿Realizaste supervisiones clínicas o pasantías?"
              data-supervision-select
              required
            >
              <option value="">Seleccioná una opción</option>
              <option value="Sí">Sí</option>
              <option value="No">No</option>
            </select>
          </label>
          <label class="field">
            <span>¿Con qué profesional?</span>
            <input
              name="supervisingProfessional"
              data-supervising-professional
              disabled
            />
            <small data-supervision-hint>Se habilita si seleccionás “Sí”.</small
            >
          </label>
          <label class="field field--wide">
            <span class="label-with-info">
              ¿Contás con consultorio equipado para colgar equipamiento
              suspendido? <b aria-hidden="true">*</b>
              <span class="info-wrap">
                <button
                  type="button"
                  class="info-button"
                  aria-label="Más información sobre equipamiento suspendido"
                  aria-expanded="false"
                  data-info-button>i</button
                >
                <span class="field-help" role="tooltip" data-info-content hidden
                  >Considerá tanto la disponibilidad de equipamiento como una
                  estructura segura y preparada específicamente para su
                  suspensión.</span
                >
              </span>
            </span>
            <select
              name="hasEquippedOffice"
              aria-label="¿Contás con consultorio equipado para colgar equipamiento suspendido?"
              required
            >
              <option value="">Seleccioná una opción</option>
              <option value="Sí">Sí</option>
              <option value="No">No</option>
              <option value="No actualmente">No actualmente</option>
            </select>
          </label>
          <label class="field field--wide">
            <span class="label-with-info">
              Población de pacientes que asistís <b aria-hidden="true">*</b>
              <span class="info-wrap">
                <button
                  type="button"
                  class="info-button"
                  aria-label="Más información sobre población de pacientes"
                  aria-expanded="false"
                  data-info-button>i</button
                >
                <span class="field-help" role="tooltip" data-info-content hidden
                  >Indicá edades y si atendés sólo déficits de Integración
                  Sensorial o también pacientes con otras patologías primarias.
                  En ese caso, especificá cuáles.</span
                >
              </span>
            </span>
            <textarea
              name="patientPopulation"
              aria-label="Población de pacientes que asistís"
              rows="5"
              required></textarea>
          </label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="4" hidden>
        <legend>Categoría de asociación</legend>
        <p class="panel-intro">
          La categoría se define según la formación acreditada y la
          documentación presentada.
        </p>

        <div class="hours-summary" aria-live="polite">
          <span aria-hidden="true">✓</span>
          <p>
            <strong data-final-hours>Registraste 0 horas</strong><br />La
            comisión de AISA validará certificados, profesión y edad antes de
            asignar la categoría.
          </p>
        </div>

        <div class="membership-types">
          <article>
            <p class="membership-type__label">Socio activo</p>
            <h4>Participación con voz y voto</h4>
            <p>
              Terapistas Ocupacionales mayores de 25 años con entrenamiento en
              terapia de Integración Sensorial y un mínimo de cien (100) horas
              teóricas y prácticas, comprobadas mediante certificados.
            </p>
          </article>
          <article>
            <p class="membership-type__label">Socio adherente</p>
            <h4>Participación con voz</h4>
            <p>
              Quienes no reúnan las cualidades para ser socio activo pueden
              incorporarse como socios adherentes, con derecho a voz pero sin
              derecho a voto.
            </p>
          </article>
        </div>

        <label class="check-field">
          <input type="checkbox" name="informationConfirmation" required />
          <span
            >Declaro que la información ingresada es correcta y comprendo que
            AISA deberá verificar la documentación antes de confirmar mi
            categoría. <b aria-hidden="true">*</b></span
          >
        </label>
      </fieldset>

      <div class="form-navigation" data-form-navigation>
        <button type="button" class="button-quiet" data-previous hidden
          >Anterior</button
        >
        <p data-step-count>Paso 1 de 5</p>
        <button type="button" class="button-primary" data-next>Continuar</button
        >
        <button type="submit" class="button-primary" data-submit hidden
          >Revisar solicitud</button
        >
      </div>

      <section class="form-complete" data-form-complete hidden tabindex="-1">
        <span class="form-complete__icon" aria-hidden="true">✓</span>
        <h3>Recibimos tu solicitud</h3>
        <p>
          Gracias por tu interés. Vamos a revisar tu información y nos pondremos
          en contacto dentro de las próximas 48 horas hábiles.
        </p>
        <button type="button" class="button-secondary" data-edit-form
          >Volver a editar</button
        >
      </section>
    </form>
  </div>

  <div class="info-scrim" data-info-scrim hidden></div>

  <template data-course-template>
    <article class="course-entry" data-course-entry>
      <div class="course-entry__header">
        <h4 data-course-title>Curso</h4>
        <button type="button" class="remove-course" data-remove-course
          >Quitar</button
        >
      </div>
      <div class="field-grid field-grid--two">
        <label class="field field--wide"
          ><span>Título del curso</span><input data-course-key="title" /></label
        >
        <label class="field"
          ><span>Disertante</span><input data-course-key="speaker" /></label
        >
        <label class="field"
          ><span>Año</span><input
            type="number"
            min="1950"
            max="2100"
            inputmode="numeric"
            data-course-key="year"
          /></label
        >
        <label class="field"
          ><span>Cantidad de horas</span><input
            type="number"
            min="0"
            step="0.5"
            inputmode="decimal"
            data-course-key="hours"
            data-course-hours
          /></label
        >
        <label class="field"
          ><span>Cátedra o institución organizadora</span><input
            data-course-key="chair"
          /></label
        >
        <label class="field field--wide"
          ><span>Lugar</span><input data-course-key="place" /></label
        >
      </div>
    </article>
  </template>
</section>

<script>
  const initialiseMembershipForm = () => {
    const form = document.querySelector<HTMLFormElement>(
      "[data-membership-form]",
    );
    if (!form || form.dataset.initialised === "true") return;
    form.dataset.initialised = "true";

    const panels = [...form.querySelectorAll<HTMLElement>("[data-step-panel]")];
    const progressItems = [
      ...form.querySelectorAll<HTMLElement>("[data-progress-step]"),
    ];
    const previousButton =
      form.querySelector<HTMLButtonElement>("[data-previous]");
    const nextButton = form.querySelector<HTMLButtonElement>("[data-next]");
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit]");
    const stepCount = form.querySelector<HTMLElement>("[data-step-count]");
    const alert = form.querySelector<HTMLElement>("[data-form-alert]");
    const navigation = form.querySelector<HTMLElement>(
      "[data-form-navigation]",
    );
    const complete = form.querySelector<HTMLElement>("[data-form-complete]");
    const editButton =
      form.querySelector<HTMLButtonElement>("[data-edit-form]");
    let currentStep = 0;

    const showStep = (step: number, focusHeading = true) => {
      currentStep = Math.max(0, Math.min(step, panels.length - 1));
      panels.forEach((panel, index) => {
        panel.hidden = index !== currentStep;
      });
      progressItems.forEach((item, index) => {
        item.toggleAttribute("aria-current", index === currentStep);
        item.classList.toggle("is-complete", index < currentStep);
      });
      if (previousButton) previousButton.hidden = currentStep === 0;
      if (nextButton) nextButton.hidden = currentStep === panels.length - 1;
      if (submitButton) submitButton.hidden = currentStep !== panels.length - 1;
      if (stepCount)
        stepCount.textContent = `Paso ${currentStep + 1} de ${panels.length}`;
      if (alert) alert.hidden = true;
      if (focusHeading) {
        panels[currentStep]
          ?.querySelector<HTMLElement>("legend")
          ?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    };

    const validatePanel = (panel: HTMLElement) => {
      const fields = [
        ...panel.querySelectorAll<
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
        >("input, select, textarea"),
      ].filter((field) => !field.disabled);
      const invalid = fields.find((field) => !field.checkValidity());
      if (!invalid) return true;
      if (alert) {
        alert.textContent = "Revisá los campos marcados antes de continuar.";
        alert.hidden = false;
      }
      invalid.reportValidity();
      invalid.focus();
      return false;
    };

    nextButton?.addEventListener("click", () => {
      const panel = panels[currentStep];
      if (panel && validatePanel(panel)) showStep(currentStep + 1);
    });
    previousButton?.addEventListener("click", () => showStep(currentStep - 1));

    const supervisionSelect = form.querySelector<HTMLSelectElement>(
      "[data-supervision-select]",
    );
    const supervisorInput = form.querySelector<HTMLInputElement>(
      "[data-supervising-professional]",
    );
    const supervisionHint = form.querySelector<HTMLElement>(
      "[data-supervision-hint]",
    );
    const updateSupervision = () => {
      if (!supervisionSelect || !supervisorInput) return;
      const isRequired = supervisionSelect.value === "Sí";
      supervisorInput.disabled = !isRequired;
      supervisorInput.required = isRequired;
      if (!isRequired) supervisorInput.value = "";
      if (supervisionHint)
        supervisionHint.textContent = isRequired
          ? "Ingresá el nombre y apellido."
          : "Se habilita si seleccionás “Sí”.";
    };
    supervisionSelect?.addEventListener("change", updateSupervision);

    const courseList = form.querySelector<HTMLElement>("[data-course-list]");
    const courseTemplate = document.querySelector<HTMLTemplateElement>(
      "[data-course-template]",
    );
    const addCourseButton =
      form.querySelector<HTMLButtonElement>("[data-add-course]");
    const hoursTotal = form.querySelector<HTMLElement>("[data-hours-total]");
    const finalHours = form.querySelector<HTMLElement>("[data-final-hours]");

    const calculateHours = () => {
      const total = [
        ...form.querySelectorAll<HTMLInputElement>("[data-course-hours]"),
      ].reduce((sum, input) => sum + (Number.parseFloat(input.value) || 0), 0);
      const formatted = new Intl.NumberFormat("es-AR", {
        maximumFractionDigits: 1,
      }).format(total);
      if (hoursTotal)
        hoursTotal.textContent = `${formatted} ${total === 1 ? "hora" : "horas"}`;
      if (finalHours)
        finalHours.textContent = `Registraste ${formatted} ${total === 1 ? "hora" : "horas"}`;
    };

    const renumberCourses = () => {
      const entries = [
        ...form.querySelectorAll<HTMLElement>("[data-course-entry]"),
      ];
      entries.forEach((entry, index) => {
        const title = entry.querySelector<HTMLElement>("[data-course-title]");
        if (title) title.textContent = `Curso ${index + 1}`;
        entry
          .querySelectorAll<HTMLInputElement>("[data-course-key]")
          .forEach((input) => {
            input.name = `courses[${index}][${input.dataset.courseKey}]`;
          });
      });
    };

    addCourseButton?.addEventListener("click", () => {
      if (!courseList || !courseTemplate) return;
      const fragment = courseTemplate.content.cloneNode(
        true,
      ) as DocumentFragment;
      courseList.append(fragment);
      renumberCourses();
      const entries = courseList.querySelectorAll<HTMLElement>(
        "[data-course-entry]",
      );
      entries[entries.length - 1]
        ?.querySelector<HTMLInputElement>("input")
        ?.focus();
    });

    courseList?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const removeButton = target.closest<HTMLButtonElement>(
        "[data-remove-course]",
      );
      if (!removeButton) return;
      removeButton.closest("[data-course-entry]")?.remove();
      renumberCourses();
      calculateHours();
      addCourseButton?.focus();
    });
    form.addEventListener("input", (event) => {
      if ((event.target as HTMLElement).matches("[data-course-hours]"))
        calculateHours();
    });

    const scrim = document.querySelector<HTMLElement>("[data-info-scrim]");
    const closeInfo = (returnFocus = false) => {
      const openButton = form.querySelector<HTMLButtonElement>(
        '[data-info-button][aria-expanded="true"]',
      );
      form
        .querySelectorAll<HTMLElement>("[data-info-content]")
        .forEach((content) => {
          content.hidden = true;
        });
      form
        .querySelectorAll<HTMLButtonElement>("[data-info-button]")
        .forEach((button) => button.setAttribute("aria-expanded", "false"));
      if (scrim) scrim.hidden = true;
      if (returnFocus) openButton?.focus();
    };

    form.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-info-button]",
      );
      if (!button) return;
      const wasOpen = button.getAttribute("aria-expanded") === "true";
      closeInfo();
      if (wasOpen) return;
      const content = button.parentElement?.querySelector<HTMLElement>(
        "[data-info-content]",
      );
      button.setAttribute("aria-expanded", "true");
      if (content) content.hidden = false;
      if (scrim && window.matchMedia("(max-width: 47.99rem)").matches)
        scrim.hidden = false;
    });
    scrim?.addEventListener("click", () => closeInfo(true));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeInfo(true);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const invalidPanelIndex = panels.findIndex(
        (panel) => !validatePanel(panel),
      );
      if (invalidPanelIndex >= 0) {
        showStep(invalidPanelIndex, false);
        validatePanel(panels[invalidPanelIndex]);
        return;
      }
      panels.forEach((panel) => {
        panel.hidden = true;
      });
      if (navigation) navigation.hidden = true;
      if (complete) {
        complete.hidden = false;
        complete.focus();
      }
      progressItems.forEach((item) => item.classList.add("is-complete"));
    });

    editButton?.addEventListener("click", () => {
      if (complete) complete.hidden = true;
      if (navigation) navigation.hidden = false;
      showStep(4, false);
      panels[4]
        ?.querySelector<HTMLElement>("legend")
        ?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    showStep(0, false);
    updateSupervision();
    calculateHours();
  };

  document.addEventListener("astro:page-load", initialiseMembershipForm);
  initialiseMembershipForm();
</script>

