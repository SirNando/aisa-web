---
import { MEMBERSHIP_COUNTRY_CODES, countryName } from "../lib/membershipCheckout";

const platformApiUrl = import.meta.env.PUBLIC_DIRECTORY_API_URL.replace(/\/+$/u, "");
---

<section
  id="solicitud"
  class="membership-section section-space"
  data-membership-section
  data-platform-api-url={platformApiUrl}
>
  <div class="site-container">
    <header class="membership-heading" data-reveal>
      <h2>Asociate a AISA</h2>
      <p>
        Completá tus datos, elegí cómo abonar y continuá de forma segura en
        PagoTIC.
      </p>
    </header>

    <form class="membership-form" data-membership-form novalidate>
      <div class="membership-form__header">
        <div>
          <h3>Solicitud de asociación</h3>
          <p>Los campos marcados con * son obligatorios.</p>
        </div>
      </div>

      <ol class="form-progress" aria-label="Progreso de la solicitud">
        <li data-progress-step aria-current="step"><span>1</span> Tus datos</li>
        <li data-progress-step><span>2</span> Estudios</li>
        <li data-progress-step><span>3</span> Forma de pago</li>
      </ol>

      <p class="form-alert" data-form-alert role="alert" tabindex="-1" hidden></p>

      <fieldset class="form-panel" data-step-panel="0">
        <legend tabindex="-1">Tus datos</legend>
        <p class="panel-intro">
          Usaremos esta información para crear tu acceso y evitar solicitudes
          duplicadas.
        </p>

        <div class="field-grid">
          <label class="field">
            <span>Nombres <b aria-hidden="true">*</b></span>
            <input name="firstNames" autocomplete="given-name" maxlength="120" required />
          </label>
          <label class="field">
            <span>Apellidos <b aria-hidden="true">*</b></span>
            <input name="lastNames" autocomplete="family-name" maxlength="120" required />
          </label>
          <label class="field">
            <span>Correo electrónico <b aria-hidden="true">*</b></span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
          <label class="field">
            <span>Celular <b aria-hidden="true">*</b></span>
            <input name="mobile" type="tel" autocomplete="tel" maxlength="60" required />
          </label>
          <label class="field">
            <span>Nacionalidad <b aria-hidden="true">*</b></span>
            <select name="nationality" required>
              <option value="">Seleccioná un país</option>
              {MEMBERSHIP_COUNTRY_CODES.map((code) => <option value={code}>{countryName(code)}</option>)}
            </select>
          </label>
          <label class="field">
            <span>País de residencia <b aria-hidden="true">*</b></span>
            <select name="residenceCountry" autocomplete="country" data-residence-country required>
              {MEMBERSHIP_COUNTRY_CODES.map((code) => (
                <option value={code} selected={code === "AR"}>{countryName(code)}</option>
              ))}
            </select>
          </label>
          <label class="field" data-document-type-field hidden>
            <span>Tipo de documento <b aria-hidden="true">*</b></span>
            <select name="documentType" data-document-type disabled>
              <option value="national_id">Documento nacional</option>
              <option value="passport">Pasaporte</option>
            </select>
          </label>
          <label class="field">
            <span><span data-document-label>CUIL/CUIT</span> <b aria-hidden="true">*</b></span>
            <input
              name="documentNumber"
              inputmode="numeric"
              autocomplete="off"
              placeholder="20-12345678-3"
              maxlength="24"
              aria-describedby="membership-document-help"
              data-document-number
              required
            />
            <small id="membership-document-help" data-document-help>Ingresá los 11 dígitos de tu CUIL o CUIT.</small>
          </label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="1" hidden>
        <legend tabindex="-1">Estudios universitarios</legend>
        <p class="panel-intro">Estos datos son privados y se guardarán en tu Perfil.</p>
        <div class="field-grid">
          <label class="field"><span>Título <b aria-hidden="true">*</b></span><input name="profession" maxlength="180" required /></label>
          <label class="field"><span>Universidad <b aria-hidden="true">*</b></span><input name="university" maxlength="220" required /></label>
          <label class="field"><span>Maestría o doctorado (opcional)</span><input name="postgraduateStudies" maxlength="300" /></label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="2" hidden>
        <legend tabindex="-1">Elegí cómo abonar</legend>
        <p class="panel-intro">
          El importe se obtiene directamente desde la plataforma antes de
          generar la orden.
        </p>

        <div class="plan-actions">
          <button
            type="button"
            class="button-quiet"
            data-membership-refresh
            aria-controls="membership-plans"
          >
            <span data-membership-refresh-label>Actualizar planes</span>
          </button>
        </div>

        <div class="plan-loading" data-plan-loading role="status">
          Cargando planes disponibles…
        </div>

        <div id="membership-plans" class="membership-plans" data-membership-plans hidden></div>
        <template data-membership-plan-template>
          <label class="membership-plan">
            <input type="radio" name="planId" required />
            <span class="membership-plan__surface">
              <span><strong data-plan-label></strong><small data-plan-description></small></span>
              <b data-plan-amount></b>
            </span>
          </label>
        </template>

        <div class="payment-total" data-payment-total hidden aria-live="polite">
          <span>Total a pagar</span>
          <strong data-total-amount></strong>
        </div>

        <div class="turnstile-slot" data-turnstile-slot aria-label="Verificación de seguridad"></div>

        <label class="membership-honeypot" aria-hidden="true">
          Sitio web
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </fieldset>

      <div class="form-navigation">
        <button type="button" class="button-quiet" data-previous hidden>Anterior</button>
        <p data-step-count>Paso 1 de 3</p>
        <button type="button" class="button-primary" data-next>Continuar</button>
        <button type="submit" class="button-primary" data-submit hidden>
          Ir a PagoTIC
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  import {
    documentFieldFor,
    formatCuit,
    isPublicMembershipPlans,
    parseMembershipDocument,
    parseMembershipProfile,
    type PublicMembershipPlan,
  } from "../lib/membershipCheckout";

  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    execute: (widgetId: string) => void;
    reset: (widgetId: string) => void;
  };

  const TURNSTILE_SCRIPT = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
  let cleanupMembership: (() => void) | undefined;

  const friendlyError = (error: unknown, fallback: string) => {
    if (!(error instanceof Error)) return fallback;
    return /failed to fetch|load failed|networkerror/iu.test(error.message)
      ? fallback
      : error.message;
  };

  const loadTurnstile = () =>
    new Promise<TurnstileApi>((resolve, reject) => {
      const current = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      if (current) {
        resolve(current);
        return;
      }
      const existing = document.querySelector<HTMLScriptElement>(`script[src="${TURNSTILE_SCRIPT}"]`);
      const script = existing ?? document.createElement("script");
      const onLoad = () => {
        const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (api) resolve(api);
        else reject(new Error("Turnstile no quedó disponible."));
      };
      script.addEventListener("load", onLoad, { once: true });
      script.addEventListener("error", () => reject(new Error("No se pudo cargar Turnstile.")), { once: true });
      if (!existing) {
        script.src = TURNSTILE_SCRIPT;
        script.async = true;
        script.defer = true;
        document.head.append(script);
      }
    });

  const initialiseMembershipForm = () => {
    const section = document.querySelector<HTMLElement>("[data-membership-section]");
    const form = section?.querySelector<HTMLFormElement>("[data-membership-form]");
    if (!section || !form || form.dataset.initialised === "true") return;
    form.dataset.initialised = "true";

    const apiUrl = section.dataset.platformApiUrl ?? "";
    const panels = [...form.querySelectorAll<HTMLElement>("[data-step-panel]")];
    const progress = [...form.querySelectorAll<HTMLElement>("[data-progress-step]")];
    const previous = form.querySelector<HTMLButtonElement>("[data-previous]");
    const next = form.querySelector<HTMLButtonElement>("[data-next]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const stepCount = form.querySelector<HTMLElement>("[data-step-count]");
    const alert = form.querySelector<HTMLElement>("[data-form-alert]");
    const plansElement = form.querySelector<HTMLElement>("[data-membership-plans]");
    const planTemplate = form.querySelector<HTMLTemplateElement>("[data-membership-plan-template]");
    const plansLoading = form.querySelector<HTMLElement>("[data-plan-loading]");
    const refreshButton = form.querySelector<HTMLButtonElement>(
      "[data-membership-refresh]",
    );
    const refreshLabel = form.querySelector<HTMLElement>(
      "[data-membership-refresh-label]",
    );
    const total = form.querySelector<HTMLElement>("[data-payment-total]");
    const totalAmount = form.querySelector<HTMLElement>("[data-total-amount]");
    const turnstileSlot = form.querySelector<HTMLElement>("[data-turnstile-slot]");
    const residenceSelect = form.querySelector<HTMLSelectElement>("[data-residence-country]");
    const documentTypeField = form.querySelector<HTMLElement>("[data-document-type-field]");
    const documentTypeSelect = form.querySelector<HTMLSelectElement>("[data-document-type]");
    const documentInput = form.querySelector<HTMLInputElement>("[data-document-number]");
    const documentLabel = form.querySelector<HTMLElement>("[data-document-label]");
    const documentHelp = form.querySelector<HTMLElement>("[data-document-help]");
    // Residents of Argentina give their CUIL/CUIT; elsewhere the national document or passport.
    const currentDocument = () => {
      const residenceCountry = residenceSelect?.value ?? "AR";
      return {
        residenceCountry,
        documentType: documentFieldFor(residenceCountry).fixedType ?? documentTypeSelect?.value ?? "",
        documentNumber: documentInput?.value ?? "",
      };
    };
    const applyResidence = () => {
      const field = documentFieldFor(residenceSelect?.value ?? "AR");
      if (documentTypeField) documentTypeField.hidden = field.fixedType !== null;
      if (documentTypeSelect) documentTypeSelect.disabled = field.fixedType !== null;
      if (documentLabel) documentLabel.textContent = field.label;
      if (documentHelp) documentHelp.textContent = field.help;
      if (documentInput) {
        documentInput.inputMode = field.inputMode;
        documentInput.placeholder = field.placeholder;
        documentInput.setCustomValidity("");
        if (field.fixedType) documentInput.value = formatCuit(documentInput.value);
      }
    };
    let currentStep = 0;
    let plans: PublicMembershipPlan[] = [];
    let currency = "ARS";
    let turnstileRequired = true;
    let turnstileSiteKey = "";
    let turnstileApi: TurnstileApi | null = null;
    let turnstileWidgetId: string | null = null;
    let tokenResolver: ((token: string) => void) | null = null;
    let tokenRejecter: ((error: Error) => void) | null = null;
    let plansRequest: AbortController | null = null;

    const showAlert = (message: string) => {
      if (!alert) return;
      alert.textContent = message;
      alert.hidden = false;
      alert.focus({ preventScroll: true });
    };
    const clearAlert = () => {
      if (alert) alert.hidden = true;
    };
    const showStep = (step: number, moveFocus = true) => {
      currentStep = Math.max(0, Math.min(step, panels.length - 1));
      panels.forEach((panel, index) => { panel.hidden = index !== currentStep; });
      progress.forEach((item, index) => {
        if (index === currentStep) item.setAttribute("aria-current", "step");
        else item.removeAttribute("aria-current");
        item.classList.toggle("is-complete", index < currentStep);
      });
      if (previous) previous.hidden = currentStep === 0;
      if (next) next.hidden = currentStep === panels.length - 1;
      if (submit) submit.hidden = currentStep !== panels.length - 1;
      if (stepCount) stepCount.textContent = `Paso ${currentStep + 1} de ${panels.length}`;
      clearAlert();
      if (moveFocus) panels[currentStep]?.querySelector<HTMLElement>("legend")?.focus();
    };
    const currentProfile = () => {
      const data = new FormData(form);
      return parseMembershipProfile({
        mobile: String(data.get("mobile") ?? ""), nationality: String(data.get("nationality") ?? ""),
        profession: String(data.get("profession") ?? ""), university: String(data.get("university") ?? ""),
        postgraduateStudies: String(data.get("postgraduateStudies") ?? ""),
      });
    };
    const showFieldError = (name: string, message: string) => {
      const field = form.elements.namedItem(name);
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return;
      const panel = field.closest<HTMLElement>("[data-step-panel]");
      if (panel) showStep(panels.indexOf(panel), false);
      field.setCustomValidity(message);
      showAlert(message);
      field.reportValidity();
      field.focus();
    };
    const validatePanel = (panel: HTMLElement) => {
      const fields = [...panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select")]
        .filter((field) => !field.disabled && field.tabIndex !== -1);
      const profile = currentProfile();
      if (!profile.ok && fields.some((field) => field.name === profile.field)) {
        showFieldError(profile.field, profile.message);
        return false;
      }
      const invalid = fields.find((field) => !field.checkValidity());
      if (invalid) {
        showAlert("Revisá los campos marcados antes de continuar.");
        invalid.reportValidity();
        invalid.focus();
        return false;
      }
      const document = panel.dataset.stepPanel === "0" && documentInput ? parseMembershipDocument(currentDocument()) : null;
      if (document && !document.ok && documentInput) {
        documentInput.setCustomValidity(document.message);
        showAlert(document.message);
        documentInput.reportValidity();
        documentInput.focus();
        return false;
      }
      return true;
    };
    const formatMoney = (amountCents: number) => new Intl.NumberFormat("es-AR", {
      style: "currency",
      currency,
    }).format(amountCents / 100);
    const updateTotal = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="planId"]:checked');
      const plan = plans.find((candidate) => candidate.id === selected?.value);
      if (total) total.hidden = !plan;
      if (totalAmount) totalAmount.textContent = plan ? formatMoney(plan.amountCents) : "";
    };
    const setRefreshState = (isRefreshing: boolean) => {
      if (refreshButton) refreshButton.disabled = isRefreshing;
      if (refreshLabel) {
        refreshLabel.textContent = isRefreshing ? "Actualizando…" : "Actualizar planes";
      }
      form.setAttribute("aria-busy", String(isRefreshing));
    };
    const loadPlans = async (isRefresh = false) => {
      plansRequest?.abort();
      const request = new AbortController();
      plansRequest = request;
      if (isRefresh) setRefreshState(true);
      else {
        if (plansLoading) {
          plansLoading.hidden = false;
          plansLoading.textContent = "Cargando planes disponibles…";
        }
        if (plansElement) plansElement.hidden = true;
      }
      try {
        const response = await fetch(`${apiUrl}/api/public/membership-plans`, {
          headers: { Accept: "application/json" },
          cache: "no-store",
          credentials: "omit",
          signal: request.signal,
        });
        const payload = await response.json() as unknown;
        if (!response.ok || !isPublicMembershipPlans(payload)) {
          const message = payload !== null && typeof payload === "object" && "message" in payload
            && typeof payload.message === "string" ? payload.message : null;
          throw new Error(message || "No pudimos cargar los planes disponibles.");
        }
        if (request !== plansRequest) return;
        const selectedPlanId = form.querySelector<HTMLInputElement>(
          'input[name="planId"]:checked',
        )?.value;
        plans = payload.plans;
        currency = payload.currency;
        turnstileRequired = payload.turnstileRequired;
        turnstileSiteKey = payload.turnstileSiteKey ?? "";
        if (turnstileSlot) turnstileSlot.hidden = !turnstileRequired;
        if (plansElement) {
          const labels = plans.map((plan) => {
            // Cloning retains Astro's scoped attributes on every element.
            const label = planTemplate?.content.firstElementChild?.cloneNode(true) as HTMLLabelElement | undefined;
            if (!label) throw new Error("No pudimos mostrar los planes disponibles.");
            const input = label.querySelector<HTMLInputElement>("input")!;
            input.value = plan.id;
            input.checked = input.value === selectedPlanId;
            label.querySelector<HTMLElement>("[data-plan-label]")!.textContent = plan.label;
            label.querySelector<HTMLElement>("[data-plan-description]")!.textContent = plan.description;
            label.querySelector<HTMLElement>("[data-plan-amount]")!.textContent = formatMoney(plan.amountCents);
            return label;
          });
          plansElement.replaceChildren(...labels);
        }
        updateTotal();
        if (plansLoading) plansLoading.hidden = true;
        if (plansElement) plansElement.hidden = false;
      } catch (error) {
        if (request.signal.aborted || request !== plansRequest) return;
        if (plansLoading) plansLoading.hidden = true;
        showAlert(friendlyError(error, "No pudimos cargar los planes disponibles. Intentá nuevamente en unos minutos."));
        if (submit) submit.disabled = plans.length === 0;
      } finally {
        if (request !== plansRequest) return;
        plansRequest = null;
        if (isRefresh) setRefreshState(false);
      }
    };
    if (refreshButton) {
      refreshButton.addEventListener("click", () => void loadPlans(true));
    }
    const getTurnstileToken = async () => {
      if (!turnstileRequired) return "";
      if (!turnstileSlot || !turnstileSiteKey) throw new Error("La verificación de seguridad no está disponible.");
      turnstileApi ??= await loadTurnstile();
      if (!turnstileWidgetId) {
        turnstileWidgetId = turnstileApi.render(turnstileSlot, {
          sitekey: turnstileSiteKey,
          action: "membership_checkout",
          execution: "execute",
          appearance: "interaction-only",
          callback: (token: string) => tokenResolver?.(token),
          "error-callback": () => tokenRejecter?.(new Error("No pudimos completar la verificación de seguridad.")),
          "expired-callback": () => tokenRejecter?.(new Error("La verificación de seguridad venció.")),
          "timeout-callback": () => tokenRejecter?.(new Error("La verificación de seguridad tardó demasiado.")),
        });
      }
      return new Promise<string>((resolve, reject) => {
        tokenResolver = resolve;
        tokenRejecter = reject;
        turnstileApi?.execute(turnstileWidgetId as string);
      }).finally(() => {
        tokenResolver = null;
        tokenRejecter = null;
      });
    };

    documentInput?.addEventListener("input", () => {
      if (documentFieldFor(residenceSelect?.value ?? "AR").fixedType) documentInput.value = formatCuit(documentInput.value);
      documentInput.setCustomValidity("");
    });
    residenceSelect?.addEventListener("change", applyResidence);
    applyResidence();
    form.addEventListener("input", (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.setCustomValidity("");
    });
    form.addEventListener("change", (event) => {
      if ((event.target as HTMLInputElement).name === "planId") updateTotal();
    });
    next?.addEventListener("click", () => {
      const panel = panels[currentStep];
      if (panel && validatePanel(panel)) showStep(currentStep + 1);
    });
    previous?.addEventListener("click", () => showStep(currentStep - 1));
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalidPanel = panels.findIndex((panel) => !validatePanel(panel));
      if (invalidPanel >= 0) {
        showStep(invalidPanel, false);
        validatePanel(panels[invalidPanel]);
        return;
      }
      if (!submit) return;
      submit.disabled = true;
      submit.textContent = "Preparando pago…";
      clearAlert();
      try {
        const token = await getTurnstileToken();
        const formData = new FormData(form);
        const storageKey = "aisa-membership-checkout-key";
        const storagePayloadKey = "aisa-membership-checkout-payload";
        const parsedDocument = parseMembershipDocument(currentDocument());
        if (!parsedDocument.ok) throw new Error(parsedDocument.message);
        const { residenceCountry, documentType, documentNumber } = parsedDocument;
        const parsedProfile = currentProfile();
        if (!parsedProfile.ok) throw new Error(parsedProfile.message);
        const privateProfile = parsedProfile.profile;
        const checkoutIdentity = JSON.stringify({
          firstNames: String(formData.get("firstNames") ?? "").trim(),
          lastNames: String(formData.get("lastNames") ?? "").trim(),
          email: String(formData.get("email") ?? "").trim().toLocaleLowerCase("es-AR"),
          ...privateProfile,
          residenceCountry,
          documentType,
          documentNumber,
          planId: String(formData.get("planId") ?? ""),
        });
        let idempotencyKey = sessionStorage.getItem(storageKey);
        if (!idempotencyKey || sessionStorage.getItem(storagePayloadKey) !== checkoutIdentity) {
          idempotencyKey = globalThis.crypto.randomUUID();
          sessionStorage.setItem(storageKey, idempotencyKey);
          sessionStorage.setItem(storagePayloadKey, checkoutIdentity);
        }
        const response = await fetch(`${apiUrl}/api/public/membership-checkouts`, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          credentials: "omit",
          body: JSON.stringify({
            firstNames: String(formData.get("firstNames") ?? ""),
            lastNames: String(formData.get("lastNames") ?? ""),
            email: String(formData.get("email") ?? ""),
            ...privateProfile,
            residenceCountry,
            documentType,
            documentNumber,
            planId: String(formData.get("planId") ?? ""),
            website: String(formData.get("website") ?? ""),
            idempotencyKey,
            turnstileToken: token,
          }),
        });
        const payload = await response.json() as { checkoutUrl?: string; message?: string; field?: string };
        if (!response.ok || !payload.checkoutUrl) {
          if (payload.field && payload.message) showFieldError(payload.field, payload.message);
          throw new Error(payload.message || "No pudimos iniciar el pago.");
        }
        const checkoutUrl = new URL(payload.checkoutUrl);
        if (checkoutUrl.protocol !== "https:") throw new Error("PagoTIC devolvió una dirección no válida.");
        window.location.assign(checkoutUrl.toString());
      } catch (error) {
        showAlert(friendlyError(error, "No pudimos iniciar el pago. Intentá nuevamente en unos minutos."));
        if (turnstileApi && turnstileWidgetId) turnstileApi.reset(turnstileWidgetId);
        submit.disabled = false;
        submit.textContent = "Ir a PagoTIC";
      }
    });

    showStep(0, false);
    void loadPlans();
    cleanupMembership = () => {
      plansRequest?.abort();
      plansRequest = null;
      cleanupMembership = undefined;
    };
  };

  document.addEventListener("astro:page-load", initialiseMembershipForm);
  document.addEventListener("astro:before-swap", () => cleanupMembership?.());
  initialiseMembershipForm();
</script>

<style>
  .membership-section {
    background: linear-gradient(180deg, var(--color-white), var(--color-mist));
  }

  .membership-heading {
    width: min(100%, 42rem);
    margin: 0 auto 2rem;
    text-align: center;
  }

  .membership-heading h2 {
    font-size: var(--text-section-title);
    line-height: 1.12;
  }

  .membership-heading p {
    margin-top: 0.65rem;
    color: var(--color-muted);
  }

  .membership-form {
    width: min(100%, 52rem);
    margin-inline: auto;
    overflow: clip;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-raised);
  }

  .membership-form__header,
  .form-panel,
  .form-navigation {
    padding: 1.4rem clamp(1rem, 4vw, 2rem);
  }

  .membership-form__header {
    border-bottom: 1px solid var(--color-border);
  }

  .membership-form__header h3 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .membership-form__header p,
  .panel-intro,
  .field small {
    color: var(--color-muted);
  }

  .membership-form__header p,
  .panel-intro {
    margin-top: 0.35rem;
    font-size: var(--text-sm);
  }

