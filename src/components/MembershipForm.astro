---
const platformApiUrl = import.meta.env.PUBLIC_DIRECTORY_API_URL.replace(/\/+$/u, "");
---

<section
  id="solicitud"
  class="membership-section section-space"
  data-membership-section
  data-platform-api-url={platformApiUrl}
>
  <div class="site-container">
    <header class="membership-heading" data-reveal>
      <h2>Asociate a AISA</h2>
      <p>
        Completá tus datos, elegí cómo abonar y continuá de forma segura en
        PagoTIC.
      </p>
    </header>

    <form class="membership-form" data-membership-form novalidate>
      <div class="membership-form__header">
        <div>
          <h3>Solicitud de asociación</h3>
          <p>Los campos marcados con * son obligatorios.</p>
        </div>
      </div>

      <ol class="form-progress" aria-label="Progreso de la solicitud">
        <li data-progress-step aria-current="step"><span>1</span> Tus datos</li>
        <li data-progress-step><span>2</span> Forma de pago</li>
      </ol>

      <p class="form-alert" data-form-alert role="alert" tabindex="-1" hidden></p>

      <fieldset class="form-panel" data-step-panel="0">
        <legend tabindex="-1">Tus datos</legend>
        <p class="panel-intro">
          Usaremos esta información para crear tu acceso y evitar solicitudes
          duplicadas.
        </p>

        <div class="field-grid">
          <label class="field">
            <span>Nombres <b aria-hidden="true">*</b></span>
            <input name="firstNames" autocomplete="given-name" maxlength="120" required />
          </label>
          <label class="field">
            <span>Apellidos <b aria-hidden="true">*</b></span>
            <input name="lastNames" autocomplete="family-name" maxlength="120" required />
          </label>
          <label class="field">
            <span>Correo electrónico <b aria-hidden="true">*</b></span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
          <label class="field">
            <span>CUIT/CUIL <b aria-hidden="true">*</b></span>
            <input
              name="cuit"
              inputmode="numeric"
              autocomplete="off"
              placeholder="20-12345678-3"
              maxlength="13"
              aria-describedby="membership-cuit-help"
              required
            />
            <small id="membership-cuit-help">Ingresá los 11 dígitos de tu CUIT o CUIL.</small>
          </label>
        </div>
      </fieldset>

      <fieldset class="form-panel" data-step-panel="1" hidden>
        <legend tabindex="-1">Elegí cómo abonar</legend>
        <p class="panel-intro">
          El importe se obtiene directamente desde la plataforma antes de
          generar la orden.
        </p>

        <div class="plan-loading" data-plan-loading role="status">
          Cargando planes disponibles…
        </div>

        <div class="membership-plans" data-membership-plans hidden>
          <label class="membership-plan">
            <input type="radio" name="planCode" value="monthly" required />
            <span class="membership-plan__surface">
              <span><strong data-plan-label="monthly">Abono mensual</strong><small data-plan-description="monthly"></small></span>
              <b data-plan-amount="monthly"></b>
            </span>
          </label>
          <label class="membership-plan">
            <input type="radio" name="planCode" value="six_month" required />
            <span class="membership-plan__surface">
              <span><strong data-plan-label="six_month">Seis meses</strong><small data-plan-description="six_month"></small></span>
              <b data-plan-amount="six_month"></b>
            </span>
          </label>
        </div>

        <div class="payment-total" data-payment-total hidden aria-live="polite">
          <span>Total a pagar</span>
          <strong data-total-amount></strong>
        </div>

        <div class="turnstile-slot" data-turnstile-slot aria-label="Verificación de seguridad"></div>

        <label class="membership-honeypot" aria-hidden="true">
          Sitio web
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </fieldset>

      <div class="form-navigation">
        <button type="button" class="button-quiet" data-previous hidden>Anterior</button>
        <p data-step-count>Paso 1 de 2</p>
        <button type="button" class="button-primary" data-next>Continuar</button>
        <button type="submit" class="button-primary" data-submit hidden>
          Ir a PagoTIC
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  import {
    formatCuit,
    isPublicMembershipPlans,
    isValidCuit,
    normalizeCuit,
    type PublicMembershipPlan,
  } from "../lib/membershipCheckout";

  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    execute: (widgetId: string) => void;
    reset: (widgetId: string) => void;
  };

  const TURNSTILE_SCRIPT = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";

  const friendlyError = (error: unknown, fallback: string) => {
    if (!(error instanceof Error)) return fallback;
    return /failed to fetch|load failed|networkerror/iu.test(error.message)
      ? fallback
      : error.message;
  };

  const loadTurnstile = () =>
    new Promise<TurnstileApi>((resolve, reject) => {
      const current = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      if (current) {
        resolve(current);
        return;
      }
      const existing = document.querySelector<HTMLScriptElement>(`script[src="${TURNSTILE_SCRIPT}"]`);
      const script = existing ?? document.createElement("script");
      const onLoad = () => {
        const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (api) resolve(api);
        else reject(new Error("Turnstile no quedó disponible."));
      };
      script.addEventListener("load", onLoad, { once: true });
      script.addEventListener("error", () => reject(new Error("No se pudo cargar Turnstile.")), { once: true });
      if (!existing) {
        script.src = TURNSTILE_SCRIPT;
        script.async = true;
        script.defer = true;
        document.head.append(script);
      }
    });

  const initialiseMembershipForm = () => {
    const section = document.querySelector<HTMLElement>("[data-membership-section]");
    const form = section?.querySelector<HTMLFormElement>("[data-membership-form]");
    if (!section || !form || form.dataset.initialised === "true") return;
    form.dataset.initialised = "true";

    const apiUrl = section.dataset.platformApiUrl ?? "";
    const panels = [...form.querySelectorAll<HTMLElement>("[data-step-panel]")];
    const progress = [...form.querySelectorAll<HTMLElement>("[data-progress-step]")];
    const previous = form.querySelector<HTMLButtonElement>("[data-previous]");
    const next = form.querySelector<HTMLButtonElement>("[data-next]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const stepCount = form.querySelector<HTMLElement>("[data-step-count]");
    const alert = form.querySelector<HTMLElement>("[data-form-alert]");
    const plansElement = form.querySelector<HTMLElement>("[data-membership-plans]");
    const plansLoading = form.querySelector<HTMLElement>("[data-plan-loading]");
    const total = form.querySelector<HTMLElement>("[data-payment-total]");
    const totalAmount = form.querySelector<HTMLElement>("[data-total-amount]");
    const turnstileSlot = form.querySelector<HTMLElement>("[data-turnstile-slot]");
    const cuitInput = form.elements.namedItem("cuit") as HTMLInputElement | null;
    let currentStep = 0;
    let plans: PublicMembershipPlan[] = [];
    let currency = "ARS";
    let turnstileRequired = true;
    let turnstileSiteKey = "";
    let turnstileApi: TurnstileApi | null = null;
    let turnstileWidgetId: string | null = null;
    let tokenResolver: ((token: string) => void) | null = null;
    let tokenRejecter: ((error: Error) => void) | null = null;

    const showAlert = (message: string) => {
      if (!alert) return;
      alert.textContent = message;
      alert.hidden = false;
      alert.focus({ preventScroll: true });
    };
    const clearAlert = () => {
      if (alert) alert.hidden = true;
    };
    const showStep = (step: number, moveFocus = true) => {
      currentStep = Math.max(0, Math.min(step, panels.length - 1));
      panels.forEach((panel, index) => { panel.hidden = index !== currentStep; });
      progress.forEach((item, index) => {
        item.toggleAttribute("aria-current", index === currentStep);
        item.classList.toggle("is-complete", index < currentStep);
      });
      if (previous) previous.hidden = currentStep === 0;
      if (next) next.hidden = currentStep === panels.length - 1;
      if (submit) submit.hidden = currentStep !== panels.length - 1;
      if (stepCount) stepCount.textContent = `Paso ${currentStep + 1} de ${panels.length}`;
      clearAlert();
      if (moveFocus) panels[currentStep]?.querySelector<HTMLElement>("legend")?.focus();
    };
    const validatePanel = (panel: HTMLElement) => {
      const fields = [...panel.querySelectorAll<HTMLInputElement>("input")]
        .filter((field) => !field.disabled && field.tabIndex !== -1);
      const invalid = fields.find((field) => !field.checkValidity());
      if (invalid) {
        showAlert("Revisá los campos marcados antes de continuar.");
        invalid.reportValidity();
        invalid.focus();
        return false;
      }
      if (panel.dataset.stepPanel === "0" && cuitInput && !isValidCuit(cuitInput.value)) {
        cuitInput.setCustomValidity("Ingresá un CUIT/CUIL válido.");
        showAlert("Revisá el CUIT/CUIL antes de continuar.");
        cuitInput.reportValidity();
        cuitInput.focus();
        return false;
      }
      return true;
    };
    const formatMoney = (amountCents: number) => new Intl.NumberFormat("es-AR", {
      style: "currency",
      currency,
    }).format(amountCents / 100);
    const updateTotal = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="planCode"]:checked');
      const plan = plans.find((candidate) => candidate.code === selected?.value);
      if (total) total.hidden = !plan;
      if (totalAmount) totalAmount.textContent = plan ? formatMoney(plan.amountCents) : "";
    };
    const loadPlans = async () => {
      try {
        const response = await fetch(`${apiUrl}/api/public/membership-plans`, {
          headers: { Accept: "application/json" },
          credentials: "omit",
        });
        const payload = await response.json() as unknown;
        if (!response.ok || !isPublicMembershipPlans(payload)) {
          const message = payload !== null && typeof payload === "object" && "message" in payload
            && typeof payload.message === "string" ? payload.message : null;
          throw new Error(message || "No pudimos cargar los planes disponibles.");
        }
        plans = payload.plans;
        currency = payload.currency;
        turnstileRequired = payload.turnstileRequired;
        turnstileSiteKey = payload.turnstileSiteKey ?? "";
        if (turnstileSlot) turnstileSlot.hidden = !turnstileRequired;
        plans.forEach((plan) => {
          const label = form.querySelector<HTMLElement>(`[data-plan-label="${plan.code}"]`);
          const description = form.querySelector<HTMLElement>(`[data-plan-description="${plan.code}"]`);
          const amount = form.querySelector<HTMLElement>(`[data-plan-amount="${plan.code}"]`);
          if (label) label.textContent = plan.label;
          if (description) description.textContent = plan.description;
          if (amount) amount.textContent = formatMoney(plan.amountCents);
        });
        if (plansLoading) plansLoading.hidden = true;
        if (plansElement) plansElement.hidden = false;
      } catch (error) {
        if (plansLoading) plansLoading.hidden = true;
        showAlert(friendlyError(error, "No pudimos cargar los planes disponibles. Intentá nuevamente en unos minutos."));
        if (submit) submit.disabled = true;
      }
    };
    const getTurnstileToken = async () => {
      if (!turnstileRequired) return "";
      if (!turnstileSlot || !turnstileSiteKey) throw new Error("La verificación de seguridad no está disponible.");
      turnstileApi ??= await loadTurnstile();
      if (!turnstileWidgetId) {
        turnstileWidgetId = turnstileApi.render(turnstileSlot, {
          sitekey: turnstileSiteKey,
          action: "membership_checkout",
          execution: "execute",
          appearance: "interaction-only",
          callback: (token: string) => tokenResolver?.(token),
          "error-callback": () => tokenRejecter?.(new Error("No pudimos completar la verificación de seguridad.")),
          "expired-callback": () => tokenRejecter?.(new Error("La verificación de seguridad venció.")),
          "timeout-callback": () => tokenRejecter?.(new Error("La verificación de seguridad tardó demasiado.")),
        });
      }
      return new Promise<string>((resolve, reject) => {
        tokenResolver = resolve;
        tokenRejecter = reject;
        turnstileApi?.execute(turnstileWidgetId as string);
      }).finally(() => {
        tokenResolver = null;
        tokenRejecter = null;
      });
    };

    cuitInput?.addEventListener("input", () => {
      cuitInput.value = formatCuit(cuitInput.value);
      cuitInput.setCustomValidity("");
    });
    form.addEventListener("change", (event) => {
      if ((event.target as HTMLInputElement).name === "planCode") updateTotal();
    });
    next?.addEventListener("click", () => {
      const panel = panels[currentStep];
      if (panel && validatePanel(panel)) showStep(currentStep + 1);
    });
    previous?.addEventListener("click", () => showStep(currentStep - 1));
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalidPanel = panels.findIndex((panel) => !validatePanel(panel));
      if (invalidPanel >= 0) {
        showStep(invalidPanel, false);
        validatePanel(panels[invalidPanel]);
        return;
      }
      if (!submit) return;
      submit.disabled = true;
      submit.textContent = "Preparando pago…";
      clearAlert();
      try {
        const token = await getTurnstileToken();
        const formData = new FormData(form);
        const storageKey = "aisa-membership-checkout-key";
        const storagePayloadKey = "aisa-membership-checkout-payload";
        const checkoutIdentity = JSON.stringify({
          firstNames: String(formData.get("firstNames") ?? "").trim(),
          lastNames: String(formData.get("lastNames") ?? "").trim(),
          email: String(formData.get("email") ?? "").trim().toLocaleLowerCase("es-AR"),
          cuit: normalizeCuit(String(formData.get("cuit") ?? "")),
          planCode: String(formData.get("planCode") ?? ""),
        });
        let idempotencyKey = sessionStorage.getItem(storageKey);
        if (!idempotencyKey || sessionStorage.getItem(storagePayloadKey) !== checkoutIdentity) {
          idempotencyKey = globalThis.crypto.randomUUID();
          sessionStorage.setItem(storageKey, idempotencyKey);
          sessionStorage.setItem(storagePayloadKey, checkoutIdentity);
        }
        const response = await fetch(`${apiUrl}/api/public/membership-checkouts`, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          credentials: "omit",
          body: JSON.stringify({
            firstNames: String(formData.get("firstNames") ?? ""),
            lastNames: String(formData.get("lastNames") ?? ""),
            email: String(formData.get("email") ?? ""),
            cuit: normalizeCuit(String(formData.get("cuit") ?? "")),
            planCode: String(formData.get("planCode") ?? ""),
            website: String(formData.get("website") ?? ""),
            idempotencyKey,
            turnstileToken: token,
          }),
        });
        const payload = await response.json() as { checkoutUrl?: string; message?: string };
        if (!response.ok || !payload.checkoutUrl) {
          throw new Error(payload.message || "No pudimos iniciar el pago.");
        }
        const checkoutUrl = new URL(payload.checkoutUrl);
        if (checkoutUrl.protocol !== "https:") throw new Error("PagoTIC devolvió una dirección no válida.");
        window.location.assign(checkoutUrl.toString());
      } catch (error) {
        showAlert(friendlyError(error, "No pudimos iniciar el pago. Intentá nuevamente en unos minutos."));
        if (turnstileApi && turnstileWidgetId) turnstileApi.reset(turnstileWidgetId);
        submit.disabled = false;
        submit.textContent = "Ir a PagoTIC";
      }
    });

    showStep(0, false);
    void loadPlans();
  };

  document.addEventListener("astro:page-load", initialiseMembershipForm);
  initialiseMembershipForm();
</script>

<style>
  .membership-section {
    background: linear-gradient(180deg, var(--color-white), var(--color-mist));
  }

  .membership-heading {
    width: min(100%, 42rem);
    margin: 0 auto 2rem;
    text-align: center;
  }

  .membership-heading h2 {
    font-size: var(--text-section-title);
    line-height: 1.12;
  }

  .membership-heading p {
    margin-top: 0.65rem;
    color: var(--color-muted);
  }

  .membership-form {
    width: min(100%, 52rem);
    margin-inline: auto;
    overflow: clip;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-raised);
  }

  .membership-form__header,
  .form-panel,
  .form-navigation {
    padding: 1.4rem clamp(1rem, 4vw, 2rem);
  }

  .membership-form__header {
    border-bottom: 1px solid var(--color-border);
  }

  .membership-form__header h3 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .membership-form__header p,
  .panel-intro,
  .field small {
    color: var(--color-muted);
  }

  .membership-form__header p,
  .panel-intro {
    margin-top: 0.35rem;
    font-size: var(--text-sm);
  }

  .form-progress {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 1.2rem clamp(1rem, 4vw, 2rem) 0;
    list-style: none;
  }

  .form-progress li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 0.2rem solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-progress li span {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-mist);
  }

  .form-progress li[aria-current="step"],
  .form-progress li.is-complete {
    border-color: var(--color-aisa-green);
    color: var(--color-ink);
  }

  .form-progress li[aria-current="step"] span,
  .form-progress li.is-complete span {
    background: var(--color-aisa-green);
    color: var(--color-on-primary);
  }

  .form-alert {
    margin: 1.25rem clamp(1rem, 4vw, 2rem) 0;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-danger) 28%, transparent);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-danger) 6%, var(--color-white));
    color: var(--color-danger);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-panel {
    min-width: 0;
    border: 0;
  }

  .form-panel legend {
    padding: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-weight: 800;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .field b {
    color: var(--color-danger);
  }

  .field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .field input:focus-visible {
    border-color: var(--color-aisa-green);
    outline: 3px solid color-mix(in srgb, var(--color-aisa-green) 22%, transparent);
  }

  .field small {
    font-size: 0.72rem;
    font-weight: 500;
  }

  .membership-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.2rem;
  }

  .membership-plan {
    position: relative;
    cursor: pointer;
  }

  .membership-plan input {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
  }

  .membership-plan__surface {
    display: flex;
    min-height: 8rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .membership-plan input:checked + .membership-plan__surface {
    border-color: var(--color-aisa-green);
    background: var(--color-leaf-wash);
  }

  .membership-plan input:focus-visible + .membership-plan__surface {
    outline: 3px solid color-mix(in srgb, var(--color-aisa-green) 22%, transparent);
    outline-offset: 2px;
  }

  .membership-plan__surface span,
  .membership-plan__surface strong,
  .membership-plan__surface small {
    display: block;
  }

  .membership-plan__surface small {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .membership-plan__surface > b {
    color: var(--color-aisa-green-dark);
    white-space: nowrap;
  }

  .plan-loading {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .payment-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem;
    border-radius: var(--radius-control);
    background: var(--color-mist);
  }

  .payment-total strong {
    font-family: var(--font-heading);
    font-size: 1.4rem;
  }

  .turnstile-slot {
    min-height: 0;
    margin-top: 1rem;
  }

  .membership-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.8rem;
    border-top: 1px solid var(--color-border);
  }

  .form-navigation p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .form-navigation button:last-child,
  .form-navigation [data-next] {
    justify-self: end;
  }

  @media (hover: hover) and (pointer: fine) {
    .membership-plan:hover .membership-plan__surface {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 47.99rem) {
    .field-grid,
    .membership-plans {
      grid-template-columns: 1fr;
    }

    .membership-plan__surface {
      min-height: 0;
    }

    .form-navigation {
      grid-template-columns: 1fr 1fr;
    }

    .form-navigation p {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .membership-plan__surface {
      transition: none;
    }
  }
</style>
