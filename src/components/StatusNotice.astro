---
interface Props {
  title?: string;
  tone?: "sky" | "leaf" | "sand";
}

const { title = "Contenido de demostración", tone = "sand" } = Astro.props;
const tones = {
  sky: "border-aisa-sky bg-aisa-sky-wash",
  leaf: "border-aisa-green bg-aisa-leaf-wash",
  sand: "border-aisa-warning bg-aisa-sand",
};
---

<aside class:list={["rounded-aisa-control border-l-4 p-5", tones[tone]]} aria-label={title}>
  <p class="font-aisa-heading text-lg font-bold text-aisa-ink">{title}</p>
  <div class="mt-1 text-sm leading-6 text-aisa-body">
    <slot />
  </div>
</aside>
