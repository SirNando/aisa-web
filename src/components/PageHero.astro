---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  lead: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  orbitImages?: ImageMetadata[];
  imageAlt?: string;
  compact?: boolean;
  fullHeight?: boolean;
  landing?: boolean;
}

const {
  title,
  lead,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  orbitImages = [],
  imageAlt = "",
  compact = false,
  fullHeight = false,
  landing = false,
} = Astro.props;

const firstImage = orbitImages[0];
const secondImage = orbitImages[1] ?? orbitImages[0];
---

<section
  class:list={[
    "page-hero",
    (landing || fullHeight) && "page-hero--landing",
    compact && "page-hero--compact",
  ]}
  data-page-hero
  data-landing-hero={landing ? "true" : undefined}
>
  <div class="page-hero__shapes" aria-hidden="true">
    <div class="page-hero__shape page-hero__shape--one" data-parallax="0.1">
      {
        firstImage && (
          <Image
            src={firstImage}
            alt={imageAlt || "Actividad terapéutica de Integración Sensorial"}
            widths={[240, 360, 520]}
            sizes="(max-width: 768px) 160px, 19vw"
            loading="eager"
          />
        )
      }
    </div>
    <div class="page-hero__shape page-hero__shape--two" data-parallax="-0.12">
      {
        secondImage && (
          <Image
            src={secondImage}
            alt="Espacio preparado para actividades de Integración Sensorial"
            widths={[260, 420, 600]}
            sizes="(max-width: 768px) 180px, 22vw"
            loading="eager"
          />
        )
      }
    </div>
    <span class="page-hero__shape page-hero__shape--three" data-parallax="0.17"></span>
    <span class="page-hero__shape page-hero__shape--four" data-parallax="-0.08"></span>
  </div>

  <div class="page-hero__content" data-hero-content>
    <h1 class="page-hero__title" data-hero-title>{title}</h1>
    <p class="page-hero__lead">{lead}</p>
    {
      (primaryHref || secondaryHref) && (
        <div class="page-hero__actions">
          {primaryHref && primaryLabel && (
            <a class="button-primary" href={primaryHref}>{primaryLabel}</a>
          )}
          {secondaryHref && secondaryLabel && (
            <a class="button-secondary" href={secondaryHref}>{secondaryLabel}</a>
          )}
        </div>
      )
    }
    {imageAlt && <span class="sr-only">{imageAlt}</span>}
  </div>
  <div class="page-hero__curve" aria-hidden="true"></div>
</section>
