---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  lead: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  orbitImages?: ImageMetadata[];
  imageAlt?: string;
  compact?: boolean;
  fullHeight?: boolean;
  landing?: boolean;
  nextTone?: "white" | "mist" | "sand" | "leaf" | "sky";
}

const {
  title,
  lead,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  orbitImages = [],
  imageAlt = "",
  compact = false,
  fullHeight = false,
  landing = false,
  nextTone = "mist",
} = Astro.props;

const firstImage = orbitImages[0];
const secondImage = orbitImages[1] ?? orbitImages[0];
const thirdImage = orbitImages[2] ?? secondImage;
const fourthImage = orbitImages[3] ?? firstImage;

const visuals = [
  {
    kind: "image" as const,
    modifier: "one",
    source: firstImage,
    widths: [240, 360, 520],
    sizes: "(max-width: 768px) 160px, 19vw",
    loading: "eager" as const,
    parallax: 0.1,
    depth: 0.72,
  },
  {
    kind: "image" as const,
    modifier: "two",
    source: secondImage,
    widths: [260, 420, 600],
    sizes: "(max-width: 768px) 180px, 22vw",
    loading: "eager" as const,
    parallax: -0.12,
    depth: 0.88,
  },
  { kind: "shape" as const, modifier: "three", parallax: 0.17, depth: 0.46 },
  { kind: "shape" as const, modifier: "four", parallax: -0.08, depth: 0.55 },
  {
    kind: "image" as const,
    modifier: "five",
    source: thirdImage,
    widths: [120, 180, 260],
    sizes: "9vw",
    loading: "lazy" as const,
    parallax: -0.06,
    depth: 1,
  },
  {
    kind: "image" as const,
    modifier: "six",
    source: fourthImage,
    widths: [120, 180, 260],
    sizes: "8vw",
    loading: "lazy" as const,
    parallax: 0.08,
    depth: 0.95,
  },
  { kind: "shape" as const, modifier: "seven", parallax: 0.05, depth: 1.08 },
  { kind: "shape" as const, modifier: "eight", parallax: -0.05, depth: 0.64 },
];
---

<section
  class:list={[
    "page-hero",
    (landing || fullHeight) && "page-hero--landing",
    compact && "page-hero--compact",
  ]}
  data-page-hero
  data-landing-hero={landing ? "true" : undefined}
  data-next-tone={nextTone}
>
  <div class="page-hero__shapes">
    {
      visuals.map((visual) => (
        <div
          class:list={["page-hero__shape", `page-hero__shape--${visual.modifier}`]}
          data-parallax={visual.parallax}
        >
          <div class="page-hero__shape-reveal" data-hero-reveal>
            <div class="page-hero__shape-float" data-hero-idle>
              <div class="page-hero__shape-drift" data-hero-drift data-depth={visual.depth}>
                <div class="page-hero__shape-artwork">
                  {
                    visual.kind === "image" && visual.source && (
                      <Image
                        src={visual.source}
                        alt={visual.modifier === "one" ? imageAlt : ""}
                        widths={visual.widths}
                        sizes={visual.sizes}
                        loading={visual.loading}
                      />
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="page-hero__content" data-hero-content data-hero-drift data-depth="0.18">
    <h1 class="page-hero__title" data-hero-title>{title}</h1>
    <p class="page-hero__lead">{lead}</p>
    {
      (primaryHref || secondaryHref) && (
        <div class="page-hero__actions">
          {primaryHref && primaryLabel && (
            <a class="button-primary" href={primaryHref}>{primaryLabel}</a>
          )}
          {secondaryHref && secondaryLabel && (
            <a class="button-secondary" href={secondaryHref}>{secondaryLabel}</a>
          )}
        </div>
      )
    }
  </div>
  <div class="page-hero__curve" aria-hidden="true"></div>
</section>
