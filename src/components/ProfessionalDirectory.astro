---
import LocationMap from "./design-system/LocationMap.astro";
---

<section
  id="mapa"
  class="directory-explorer scroll-mt-28"
  data-directory-root
  aria-labelledby="directory-title"
>
  <div class="directory-explorer__heading">
    <div>
      <h2 id="directory-title">Encontrá consultorios cerca tuyo</h2>
      <p>
        Explorá los consultorios en el mapa, combiná los filtros o usá tu
        ubicación para ordenar las opciones por cercanía.
      </p>
    </div>
    <div class="directory-explorer__meta">
      <p class="directory-explorer__count" aria-live="polite">
        <span data-directory-count>0</span>
        <span data-directory-count-label> consultorios</span>
      </p>
      <button
        type="button"
        class="button-quiet"
        data-directory-refresh
        aria-controls="directory-results"
      >
        <span data-directory-refresh-label>Actualizar resultados</span>
      </button>
      <p class="directory-explorer__refresh-status" data-directory-refresh-status aria-live="polite"></p>
    </div>
  </div>

  <LocationMap>
    <form class="directory-filters" data-directory-form slot="filters">
      <h3>Filtrar el mapa</h3>

      <label for="directory-query">
        <span>Nombre o ubicación</span>
        <input
          id="directory-query"
          name="query"
          type="search"
          placeholder="Ej.: Córdoba o Lucía"
          autocomplete="off"
        />
      </label>

      <div class="directory-filters__pair">
        <label for="directory-province">
          <span>Provincia</span>
          <select id="directory-province" name="province">
            <option value="">Todas</option>
          </select>
        </label>

        <label for="directory-locality">
          <span>Localidad</span>
          <select id="directory-locality" name="locality">
            <option value="">Todas</option>
          </select>
        </label>
      </div>

      <label for="directory-sort">
        <span>Ordenar resultados</span>
        <select id="directory-sort" name="sort" data-directory-sort disabled>
          <option value="distance" data-distance-option>
            Más cercanos
          </option>
        </select>
      </label>

      <div class="directory-filters__actions">
        <button type="button" class="button-primary" data-directory-geolocate>
          <svg
            viewBox="0 0 20 20"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="10"
              cy="10"
              r="3"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M10 2v2m0 12v2M2 10h2m12 0h2"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
          <span data-geolocate-label>Usar mi ubicación</span>
        </button>
        <button type="button" class="button-quiet" data-directory-reset>
          Limpiar
        </button>
      </div>

      <p
        class="directory-filters__status"
        data-geolocation-status
        aria-live="polite"
      ></p>
    </form>
  </LocationMap>

  <div id="directory-results" class="directory-results" data-directory-results>
    <p class="directory-empty" data-directory-loading role="status">
      Cargando consultorios…
    </p>
  </div>

  <div class="directory-empty" hidden data-directory-empty>
    <h3>No encontramos coincidencias</h3>
    <p>
      Probá con otra ubicación o limpiá los filtros para volver a ver todos los
      perfiles.
    </p>
  </div>

  <noscript>
    <p class="directory-noscript">
      Activá JavaScript para filtrar el mapa y usar la búsqueda por cercanía.
    </p>
  </noscript>
</section>

<script>
  import maplibregl, {
    type Map as MapLibreMap,
    type Marker as MapLibreMarker,
  } from "maplibre-gl";
  import {
    normalizePublicDirectoryResponse,
    type PublicDirectoryAddress,
    type PublicDirectoryListing,
  } from "../lib/publicDirectory";
  import { distanceInKilometres, matchesDirectoryListing } from "../lib/directoryFilters";
  import type {
    Coordinates,
    DirectoryFilters,
  } from "../lib/directoryFilters";

  interface MarkerRecord {
    listing: PublicDirectoryListing;
    marker: MapLibreMarker;
    element: HTMLButtonElement;
  }

  const MAP_STYLE_URL = "https://tiles.openfreemap.org/styles/liberty";
  const ARGENTINA_CENTER: [number, number] = [-63.6167, -38.4161];
  const DIRECTORY_API_BASE_URL = import.meta.env.PUBLIC_DIRECTORY_API_URL;
  const DIRECTORY_API_URL = `${DIRECTORY_API_BASE_URL.replace(/\/+$/, "")}/api/public/professionals`;
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  let listings: PublicDirectoryListing[] = [];
  let cleanupDirectory: (() => void) | undefined;

  const initializeDirectory = async () => {
    cleanupDirectory?.();

    const root = document.querySelector<HTMLElement>("[data-directory-root]");
    if (!root) return;

    const form = root.querySelector<HTMLFormElement>("[data-directory-form]");
    const mapShell = root.querySelector<HTMLElement>("[data-directory-map]");
    const mapCanvas = root.querySelector<HTMLElement>("[data-directory-map-canvas]");
    const mapLoading = root.querySelector<HTMLElement>("[data-map-loading]");
    const resetButton = root.querySelector<HTMLButtonElement>(
      "[data-directory-reset]",
    );
    const geolocateButton = root.querySelector<HTMLButtonElement>(
      "[data-directory-geolocate]",
    );
    const geolocateLabel = root.querySelector<HTMLElement>(
      "[data-geolocate-label]",
    );
    const geolocationStatus = root.querySelector<HTMLElement>(
      "[data-geolocation-status]",
    );
    const provinceSelect = root.querySelector<HTMLSelectElement>(
      "#directory-province",
    );
    const localitySelect = root.querySelector<HTMLSelectElement>(
      "#directory-locality",
    );
    const sortSelect = root.querySelector<HTMLSelectElement>(
      "[data-directory-sort]",
    );
    const results = root.querySelector<HTMLElement>("[data-directory-results]");
    const loading = root.querySelector<HTMLElement>("[data-directory-loading]");
    let cards = Array.from(
      root.querySelectorAll<HTMLElement>("[data-directory-card]"),
    );
    const count = root.querySelector<HTMLElement>("[data-directory-count]");
    const countLabel = root.querySelector<HTMLElement>(
      "[data-directory-count-label]",
    );
    const refreshButton = root.querySelector<HTMLButtonElement>(
      "[data-directory-refresh]",
    );
    const refreshLabel = root.querySelector<HTMLElement>(
      "[data-directory-refresh-label]",
    );
    const refreshStatus = root.querySelector<HTMLElement>(
      "[data-directory-refresh-status]",
    );
    const empty = root.querySelector<HTMLElement>("[data-directory-empty]");
    const popup = root.querySelector<HTMLElement>("[data-map-popup]");
    const popupName = root.querySelector<HTMLElement>("[data-map-popup-name]");
    const popupLocation = root.querySelector<HTMLElement>(
      "[data-map-popup-location]",
    );
    const popupPhone = root.querySelector<HTMLElement>("[data-map-popup-phone]");
    const popupEmail = root.querySelector<HTMLElement>("[data-map-popup-email]");
    const popupPhoneRow = root.querySelector<HTMLElement>("[data-map-popup-phone-row]");
    const popupEmailRow = root.querySelector<HTMLElement>("[data-map-popup-email-row]");
    const popupClose = root.querySelector<HTMLButtonElement>(
      "[data-map-popup-close]",
    );

    if (
      !form ||
      !mapCanvas ||
      !results ||
      !count ||
      !countLabel ||
      !empty ||
      !provinceSelect ||
      !localitySelect
    ) return;

    let directoryRequest: AbortController | null = null;
    cleanupDirectory = () => directoryRequest?.abort();
    const listenerCleanups: (() => void)[] = [];
    const markerRecords: MarkerRecord[] = [];
    let cardsByListingKey = new Map(
      cards.map((card) => [card.dataset.listingKey ?? "", card]),
    );
    let directoryMap: MapLibreMap | null = null;
    let userLocationMarker: MapLibreMarker | null = null;
    let userOrigin: Coordinates | null = null;
    let activeListingKey = "";
    let mapReady = false;

    const listen = (
      target: EventTarget,
      type: string,
      handler: EventListenerOrEventListenerObject,
    ) => {
      target.addEventListener(type, handler);
      listenerCleanups.push(() => target.removeEventListener(type, handler));
    };

    const getFilters = (): DirectoryFilters => {
      const fields = new FormData(form);
      return {
        query: String(fields.get("query") ?? ""),
        province: String(fields.get("province") ?? ""),
        locality: String(fields.get("locality") ?? ""),
      };
    };

    const addText = (parent: HTMLElement, tag: string, text: string, className?: string) => {
      const element = document.createElement(tag);
      if (className) element.className = className;
      element.textContent = text;
      parent.append(element);
      return element;
    };

    const createCard = (listing: PublicDirectoryListing, index: number) => {
      const card = document.createElement("article");
      card.className = "directory-card";
      card.dataset.directoryCard = "true";
      card.dataset.listingKey = listing.clientKey;
      card.dataset.originalIndex = String(index);

      const main = document.createElement("div");
      main.className = "directory-card__main";
      const identity = document.createElement("div");
      identity.className = "directory-card__identity";
      const identityText = document.createElement("div");
      identity.append(identityText);
      addText(
        identityText,
        "p",
        listing.address.label,
        "directory-card__office",
      );
      addText(identityText, "h3", listing.displayName);
      addText(
        identityText,
        "p",
        listing.address.formatted,
        "directory-card__location",
      ).dataset.cardLocation = "true";
      main.append(identity);

      const contact = document.createElement("dl");
      contact.className = "directory-card__contact";
      if (listing.phone) {
        const phone = document.createElement("div");
        addText(phone, "dt", "Teléfono");
        addText(phone, "dd", listing.phone);
        contact.append(phone);
      }
      if (listing.email) {
        const email = document.createElement("div");
        addText(email, "dt", "Email");
        addText(email, "dd", listing.email);
        contact.append(email);
      }
      if (contact.children.length) main.append(contact);
      card.append(main);

      const actions = document.createElement("div");
      actions.className = "directory-card__actions";
      const distance = addText(actions, "p", "", "directory-card__distance");
      distance.dataset.cardDistance = "true";
      distance.hidden = true;
      const locate = addText(actions, "button", "Ver en el mapa", "button-quiet") as HTMLButtonElement;
      locate.type = "button";
      locate.dataset.cardLocate = "true";
      locate.dataset.listingKey = listing.clientKey;
      actions.append(locate);
      card.append(actions);
      return card;
    };

    const populateDirectory = () => {
      cards = listings.map(createCard);
      cardsByListingKey = new Map(
        cards.map((card) => [card.dataset.listingKey ?? "", card]),
      );
      results.replaceChildren(...cards);

      const provinces = [...new Set(listings.map((listing) => listing.address.province))]
        .filter(Boolean)
        .sort((first, second) => first.localeCompare(second, "es-AR"));
      provinceSelect.replaceChildren(new Option("Todas", ""));
      provinces.forEach((province) => provinceSelect.add(new Option(province, province)));

      const localities = [
        ...new Map(
          listings
            .map((listing) => listing.address)
            .filter((address) => address.locality)
            .sort((first, second) => first.locality.localeCompare(second.locality, "es-AR"))
            .map((address) => [
              `${address.province}:${address.locality}`,
              { locality: address.locality, province: address.province },
            ]),
        ).values(),
      ];
      localitySelect.replaceChildren(new Option("Todas", ""));
      localities.forEach(({ locality, province }) => {
        const option = new Option(locality, locality);
        option.dataset.province = province;
        localitySelect.add(option);
      });
    };

    const bindCardLocateButtons = () => {
      cards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>("[data-card-locate]");
        if (!button) return;
        listen(button, "click", () =>
          setActive(
            button.dataset.listingKey ?? "",
            true,
          ),
        );
      });
    };

    const formatDistance = (distance: number) =>
      distance < 10
        ? `${distance.toLocaleString("es-AR", {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1,
          })} km`
        : `${Math.round(distance).toLocaleString("es-AR")} km`;

    const updateLocalityOptions = () => {
      if (!provinceSelect || !localitySelect) return;
      const selectedProvince = provinceSelect.value;
      Array.from(localitySelect.options).forEach((option) => {
        if (!option.value) return;
        const available =
          !selectedProvince || option.dataset.province === selectedProvince;
        option.hidden = !available;
        option.disabled = !available;
      });
      if (localitySelect.selectedOptions[0]?.disabled) localitySelect.value = "";
    };

    const closePopup = () => {
      activeListingKey = "";
      if (popup) popup.hidden = true;
      markerRecords.forEach(({ element }) => {
        element.classList.remove("is-active");
        element.setAttribute("aria-pressed", "false");
      });
      cards.forEach((card) => card.classList.remove("is-active"));
    };

    const fitMapToOffices = (visibleAddresses: PublicDirectoryAddress[]) => {
      if (!directoryMap || !mapReady || visibleAddresses.length === 0) return;

      if (visibleAddresses.length === 1) {
        const address = visibleAddresses[0];
        directoryMap.easeTo({
          center: [address.longitude, address.latitude],
          zoom: 12,
          duration: prefersReducedMotion.matches ? 0 : 650,
        });
        return;
      }

      const bounds = new maplibregl.LngLatBounds();
      visibleAddresses.forEach((address) =>
        bounds.extend([address.longitude, address.latitude]),
      );
      const desktop = window.matchMedia("(min-width: 48rem)").matches;
      directoryMap.fitBounds(bounds, {
        padding: {
          top: 55,
          right: 55,
          bottom: 55,
          left: desktop ? 410 : 55,
        },
        maxZoom: 12,
        duration: prefersReducedMotion.matches ? 0 : 650,
      });
    };

    const renderMarkers = () => {
      if (!directoryMap) return;
      markerRecords.forEach(({ marker }) => marker.remove());
      markerRecords.length = 0;

      listings.forEach((listing) => {
        const element = document.createElement("button");
        element.type = "button";
        element.className = "directory-map-marker";
        element.dataset.listingKey = listing.clientKey;
        element.setAttribute(
          "aria-label",
          `Ver ${listing.displayName} en ${listing.address.locality}, ${listing.address.province}`,
        );
        element.setAttribute("aria-pressed", "false");
        const markerArtwork = document.createElement("span");
        markerArtwork.setAttribute("aria-hidden", "true");
        element.append(markerArtwork);

        const marker = new maplibregl.Marker({
          element,
          anchor: "bottom",
        })
          .setLngLat([listing.address.longitude, listing.address.latitude])
          .addTo(directoryMap as MapLibreMap);

        markerRecords.push({ listing, marker, element });
        listen(element, "click", () => setActive(listing.clientKey));
      });
    };

    const setActive = (listingKey: string, scrollToMap = false) => {
      const record = markerRecords.find(
        ({ listing }) => listing.clientKey === listingKey,
      );
      const card = cardsByListingKey.get(listingKey);
      if (!record || record.element.hidden || !card) return;

      activeListingKey = listingKey;
      markerRecords.forEach(({ element, listing }) => {
        const active = listing.clientKey === listingKey;
        element.classList.toggle("is-active", active);
        element.setAttribute("aria-pressed", String(active));
      });
      cards.forEach((item) =>
        item.classList.toggle("is-active", item === card),
      );

      if (
        popup &&
        popupName &&
        popupLocation &&
        popupPhone &&
        popupEmail &&
        popupPhoneRow &&
        popupEmailRow
      ) {
        popupName.textContent = record.listing.displayName;
        popupLocation.textContent = record.listing.address.formatted;
        popupPhone.textContent = record.listing.phone;
        popupPhoneRow.hidden = !record.listing.phone;
        popupEmail.textContent = record.listing.email;
        popupEmailRow.hidden = !record.listing.email;
        popup.hidden = false;
      }

      directoryMap?.flyTo({
        center: [record.listing.address.longitude, record.listing.address.latitude],
        zoom: Math.max(directoryMap.getZoom(), 12),
        duration: prefersReducedMotion.matches ? 0 : 700,
        essential: false,
      });

      if (scrollToMap) {
        mapShell?.scrollIntoView({
          behavior: prefersReducedMotion.matches ? "auto" : "smooth",
          block: "start",
        });
        window.setTimeout(
          () => record.element.focus({ preventScroll: true }),
          prefersReducedMotion.matches ? 0 : 720,
        );
      }
    };

    const getVisibleCardRecords = (filters: DirectoryFilters) =>
      cards.flatMap((card) => {
        const listing = listings.find(
          (record) => record.clientKey === card.dataset.listingKey,
        );
        return listing && matchesDirectoryListing(listing, filters)
          ? [{ card, listing }]
          : [];
      });

    const sortCards = (
      visibleCards: ReturnType<typeof getVisibleCardRecords>,
    ) => {
      const ordered = [...visibleCards].sort((first, second) => {
        if (userOrigin) {
          return (
            distanceInKilometres(userOrigin, first.listing.address) -
            distanceInKilometres(userOrigin, second.listing.address)
          );
        }
        const professionalOrder = first.listing.displayName.localeCompare(
          second.listing.displayName,
          "es-AR",
        );
        return professionalOrder || first.listing.address.label.localeCompare(
          second.listing.address.label,
          "es-AR",
        );
      });

      ordered.forEach(({ card }) => results.append(card));
    };

    const applyFilters = (fitMap = false) => {
      const filters = getFilters();
      const visibleCards = getVisibleCardRecords(filters);
      const visibleListingKeys = new Set(visibleCards.map(({ listing }) => listing.clientKey));

      cards.forEach((card) => {
        const listing = listings.find((record) => record.clientKey === card.dataset.listingKey);
        const visible = visibleListingKeys.has(card.dataset.listingKey ?? "");
        card.hidden = !visible;
        if (!visible || !listing) return;

        const location = card.querySelector<HTMLElement>("[data-card-location]");
        const locateButton = card.querySelector<HTMLButtonElement>(
          "[data-card-locate]",
        );
        const distance = card.querySelector<HTMLElement>("[data-card-distance]");
        if (location) {
          location.textContent = listing.address.formatted;
        }
        if (locateButton) locateButton.dataset.listingKey = listing.clientKey;
        if (distance) {
          if (userOrigin) {
            distance.textContent = `A ${formatDistance(
              distanceInKilometres(userOrigin, listing.address),
            )}`;
            distance.hidden = false;
          } else {
            distance.hidden = true;
            distance.textContent = "";
          }
        }
      });

      markerRecords.forEach(({ listing, element }) => {
        element.hidden = !visibleListingKeys.has(listing.clientKey);
      });

      sortCards(visibleCards);
      count.textContent = String(visibleCards.length);
      countLabel.textContent =
        visibleCards.length === 1 ? " consultorio" : " consultorios";

      empty.hidden = visibleCards.length !== 0;

      if (activeListingKey && !visibleListingKeys.has(activeListingKey)) closePopup();
      if (fitMap) {
        fitMapToOffices(
          markerRecords
            .filter(({ listing }) => visibleListingKeys.has(listing.clientKey))
            .map(({ listing }) => listing.address),
        );
      }
    };

    try {
      directoryMap = new maplibregl.Map({
        container: mapCanvas,
        style: MAP_STYLE_URL,
        center: ARGENTINA_CENTER,
        zoom: 3.1,
        minZoom: 2.3,
        maxZoom: 17,
        cooperativeGestures: true,
        attributionControl: {},
      });
      directoryMap.addControl(
        new maplibregl.NavigationControl({ showCompass: false }),
        "top-right",
      );
      directoryMap.on("styleimagemissing", ({ id }) => {
        if (directoryMap?.hasImage(id)) return;
        directoryMap?.addImage(id, {
          width: 1,
          height: 1,
          data: new Uint8Array([0, 0, 0, 0]),
        });
      });

      directoryMap.once("load", () => {
        mapReady = true;
        if (mapLoading) mapLoading.hidden = true;
        renderMarkers();
        applyFilters(true);
      });
      directoryMap.on("error", () => {
        if (!mapReady && mapLoading) {
          mapLoading.textContent =
            "No pudimos cargar el mapa. Podés seguir usando el listado y los filtros.";
          mapLoading.classList.add("is-error");
        }
      });
    } catch {
      if (mapLoading) {
        mapLoading.textContent =
          "No pudimos cargar el mapa. Podés seguir usando el listado y los filtros.";
        mapLoading.classList.add("is-error");
      }
    }

    let searchTimer = 0;
    listen(form, "input", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name !== "query") return;
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => applyFilters(true), 180);
    });
    listen(form, "change", (event) => {
      if (event.target === provinceSelect) updateLocalityOptions();
      applyFilters(true);
    });
    listen(form, "submit", (event) => event.preventDefault());

    if (resetButton) {
      listen(resetButton, "click", () => {
        form.reset();
        userOrigin = null;
        userLocationMarker?.remove();
        userLocationMarker = null;
        if (sortSelect) sortSelect.disabled = true;
        updateLocalityOptions();
        closePopup();
        if (geolocationStatus) geolocationStatus.textContent = "";
        applyFilters(true);
        form.querySelector<HTMLInputElement>("#directory-query")?.focus();
      });
    }

    bindCardLocateButtons();
    if (popupClose) listen(popupClose, "click", closePopup);
    listen(root, "keydown", (event) => {
      if ((event as KeyboardEvent).key === "Escape" && activeListingKey) {
        closePopup();
      }
    });

    if (geolocateButton) {
      listen(geolocateButton, "click", () => {
        if (!geolocationStatus || !geolocateLabel) return;
        if (!("geolocation" in navigator)) {
          geolocationStatus.textContent =
            "Tu navegador no ofrece acceso a la ubicación.";
          return;
        }

        geolocateButton.disabled = true;
        geolocateLabel.textContent = "Buscando ubicación…";
        geolocationStatus.textContent = "Esperando permiso del navegador.";

        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            userOrigin = {
              latitude: coords.latitude,
              longitude: coords.longitude,
            };

            userLocationMarker?.remove();
            if (directoryMap) {
              const userMarkerElement = document.createElement("div");
              userMarkerElement.className = "directory-user-location";
              userMarkerElement.setAttribute("aria-label", "Tu ubicación aproximada");
              userLocationMarker = new maplibregl.Marker({
                element: userMarkerElement,
                anchor: "center",
              })
                .setLngLat([coords.longitude, coords.latitude])
                .addTo(directoryMap);
            }

            if (sortSelect) sortSelect.disabled = false;
            if (sortSelect) sortSelect.value = "distance";
            applyFilters(false);

            const filters = getFilters();
            const nearest = getVisibleCardRecords(filters)
              .map((record) => ({
                ...record,
                distance: distanceInKilometres(userOrigin as Coordinates, record.listing.address),
              }))
              .sort((first, second) => first.distance - second.distance)[0];

            if (nearest) {
              setActive(nearest.listing.clientKey);
              if (directoryMap) {
                const bounds = new maplibregl.LngLatBounds();
                bounds.extend([coords.longitude, coords.latitude]);
                bounds.extend([
                  nearest.listing.address.longitude,
                  nearest.listing.address.latitude,
                ]);
                directoryMap.fitBounds(bounds, {
                  padding: 80,
                  maxZoom: 13,
                  duration: prefersReducedMotion.matches ? 0 : 700,
                });
              }
              geolocationStatus.textContent = `Ordenamos los resultados por cercanía. La primera opción está a ${formatDistance(nearest.distance)}.`;
            }

            geolocateButton.disabled = false;
            geolocateLabel.textContent = "Actualizar mi ubicación";
          },
          (error) => {
            const messages: Record<number, string> = {
              1: "No pudimos acceder a tu ubicación. Podés elegir una localidad manualmente.",
              2: "Tu ubicación no está disponible en este momento.",
              3: "La búsqueda de ubicación tardó demasiado. Intentá nuevamente.",
            };
            geolocationStatus.textContent =
              messages[error.code] ?? "No pudimos obtener tu ubicación.";
            geolocateButton.disabled = false;
            geolocateLabel.textContent = "Usar mi ubicación";
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 },
        );
      });
    }

    const setRefreshState = (isRefreshing: boolean) => {
      if (refreshButton) refreshButton.disabled = isRefreshing;
      if (refreshLabel) {
        refreshLabel.textContent = isRefreshing
          ? "Actualizando…"
          : "Actualizar resultados";
      }
      if (refreshStatus && isRefreshing) refreshStatus.textContent = "";
      root.setAttribute("aria-busy", String(isRefreshing));
    };

    const loadDirectory = async (isRefresh = false) => {
      directoryRequest?.abort();
      const request = new AbortController();
      directoryRequest = request;
      if (isRefresh) setRefreshState(true);
      else if (loading) {
        loading.hidden = false;
        loading.textContent = "Cargando consultorios…";
        loading.classList.remove("is-error");
      }
      try {
        const response = await fetch(DIRECTORY_API_URL, {
          headers: { Accept: "application/json" },
          cache: "no-store",
          signal: request.signal,
        });
        if (!response.ok) throw new Error("Directory request failed.");
        if (request !== directoryRequest) return;
        const currentFilters = getFilters();
        const currentActiveListingKey = activeListingKey;
        listings = normalizePublicDirectoryResponse(await response.json());
        populateDirectory();
        const queryInput = form.querySelector<HTMLInputElement>("#directory-query");
        if (queryInput) queryInput.value = currentFilters.query;
        provinceSelect.value = [...provinceSelect.options].some(
          (option) => option.value === currentFilters.province,
        ) ? currentFilters.province : "";
        updateLocalityOptions();
        localitySelect.value = [...localitySelect.options].some(
          (option) => option.value === currentFilters.locality && !option.disabled,
        ) ? currentFilters.locality : "";
        renderMarkers();
        bindCardLocateButtons();
        if (loading) loading.hidden = true;
        applyFilters(true);
        if (currentActiveListingKey) setActive(currentActiveListingKey);
        if (refreshStatus) refreshStatus.textContent = isRefresh
          ? "Resultados actualizados."
          : "";
      } catch (error) {
        if (request.signal.aborted || request !== directoryRequest) return;
        if (loading) {
          if (!listings.length) {
            loading.textContent =
              "No pudimos cargar el directorio. Intentá nuevamente más tarde.";
            loading.classList.add("is-error");
          }
          loading.hidden = Boolean(listings.length);
        }
        if (!listings.length) applyFilters(false);
        if (isRefresh && refreshStatus) {
          refreshStatus.textContent = "No pudimos actualizar los resultados. Conservamos los datos anteriores.";
        }
      } finally {
        if (request !== directoryRequest) return;
        directoryRequest = null;
        if (isRefresh) setRefreshState(false);
      }
    };

    if (refreshButton) {
      listen(refreshButton, "click", () => void loadDirectory(true));
    }

    updateLocalityOptions();
    applyFilters(false);
    void loadDirectory();

    cleanupDirectory = () => {
      directoryRequest?.abort();
      directoryRequest = null;
      window.clearTimeout(searchTimer);
      listenerCleanups.forEach((cleanup) => cleanup());
      markerRecords.forEach(({ marker }) => marker.remove());
      userLocationMarker?.remove();
      directoryMap?.remove();
      cleanupDirectory = undefined;
    };
  };

  document.addEventListener("astro:page-load", initializeDirectory);
  document.addEventListener("astro:before-swap", () => cleanupDirectory?.());
</script>
