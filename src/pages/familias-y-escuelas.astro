---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import JourneyCard from "../components/JourneyCard.astro";
import Callout from "../components/Callout.astro";
import CardGrid from "../components/design-system/CardGrid.astro";
import InfoCard from "../components/design-system/InfoCard.astro";
import ToyPhotoFrame from "../components/design-system/ToyPhotoFrame.astro";
import { featureMedia, heroMedia } from "../data/siteMedia";

const audiences = [
  {
    title: "Familias",
    body: "Encontrá una orientación inicial para ordenar lo que observás, conversar con el equipo de salud y acompañar el proceso de evaluación.",
    href: "#familias",
    linkText: "Orientación para familias",
    tone: "leaf" as const,
    illustration: "elephant-tree" as const,
  },
  {
    title: "Docentes y educadores",
    body: "Reconocé cómo algunas diferencias en el procesamiento sensorial pueden afectar la participación, la atención y el aprendizaje en el aula.",
    href: "#docentes",
    linkText: "Orientación para docentes",
    tone: "sand" as const,
    illustration: "book-pencil" as const,
  },
  {
    title: "Profesionales de la salud",
    body: "Conocé el aporte de la Integración Sensorial y cómo articular una mirada funcional con la familia, la escuela y otros profesionales.",
    href: "#salud",
    linkText: "Orientación para salud",
    tone: "sky" as const,
    illustration: "puzzle" as const,
  },
];

const signals = [
  {
    title: "Regulación y descanso",
    body: "Se irrita fácilmente, llora sin un motivo claro o le cuesta llegar a la calma y conciliar el sueño aun cuando está cansado/a.",
    illustration: "cloud" as const,
  },
  {
    title: "Cuidado personal y tacto",
    body: "Se angustia durante la higiene, rechaza ciertas prendas o materiales, o evita el contacto físico y algunas texturas.",
    illustration: "elephant-tree" as const,
  },
  {
    title: "Alimentación",
    body: "Tiene preferencias muy marcadas, rechaza alimentos por su textura, temperatura, sabor u olor, o cuenta con un repertorio especialmente limitado.",
    illustration: "blocks" as const,
  },
  {
    title: "Movimiento y coordinación",
    body: "Busca intensamente girar o hamacarse, evita ciertos movimientos, se cansa rápido en actividades físicas o parece más torpe que otros niños/as de su edad.",
    illustration: "balloon-plane" as const,
  },
  {
    title: "Comunicación y vínculos",
    body: "Se retrasa en algunos logros del habla y el lenguaje, tiene pocas amistades o le cuesta participar en juegos y actividades compartidas.",
    illustration: "book-pencil" as const,
  },
  {
    title: "Sonidos y luz",
    body: "Se abruma en ambientes ruidosos, reacciona ante sonidos inesperados o tiene dificultades para adaptarse a la luz del sol y a la oscuridad.",
    illustration: "kite" as const,
  },
];
---

<BaseLayout
  title="Familias y escuelas"
  description="Orientación clara y no diagnóstica sobre Integración Sensorial para familias, docentes, escuelas y equipos de salud."
>
  <PageHero
    title="Entender es el primer paso para acompañar."
    lead="Conocé razones para realizar una consulta, qué esperar de una evaluación y cómo conversar con la familia, la escuela y el equipo de salud."
    primaryHref="/buscar-profesional/"
    primaryLabel="Encontrá un profesional"
    secondaryHref="#que-es"
    secondaryLabel="Leé nuestra guía"
    fullHeight={true}
    orbitImages={heroMedia.families}
    illustrations={[
      { kind: "elephant-tree", tone: "sky" },
      { kind: "blocks", tone: "leaf" },
      { kind: "puzzle", tone: "sand" },
    ]}
    imageAlt="Niña participando de una actividad de movimiento en un espacio terapéutico."
    nextTone="white"
  />

  <section id="que-es" class="section-space scroll-mt-28 bg-white">
    <div class="site-container playful-media-grid">
      <div class="reading-container">
        <h2 class="mt-4 font-aisa-heading text-aisa-section-title font-bold">
          ¿Qué es la Integración Sensorial?
        </h2>
        <div class="rich-copy">
          <p class="text-lg leading-8">
            La Integración Sensorial ayuda a comprender cómo una persona recibe,
            organiza y utiliza la información de sus sentidos para participar en
            la vida cotidiana.
          </p>
          <p class="text-lg leading-8">
            Algunas diferencias pueden observarse en el juego, la alimentación, el
            movimiento, el cuidado personal, el aprendizaje o la participación
            social. Una lista de señales no reemplaza una evaluación profesional
            ni determina por sí sola una condición.
          </p>
        </div>
      </div>
      <ToyPhotoFrame
        src={featureMedia.sensoryRice}
        secondarySrc={featureMedia.sharedPlay}
        alt="Niña explorando texturas y objetos durante una actividad de juego sensorial."
        aspect="landscape"
        tone="sky"
        objectPosition="right"
        className="playful-media-grid__media"
      />
    </div>
  </section>

  <section class="section-space">
    <div class="site-container">
      <div class="max-w-3xl">
        <h2 class="mt-4 font-aisa-heading text-aisa-section-title font-bold">
          Elegí la orientación que necesitás
        </h2>
        <p class="mt-5 text-lg leading-8">
          La conversación se enriquece cuando cada persona comparte lo que
          observa desde su contexto: la casa, el aula o el equipo de salud.
        </p>
      </div>
      <CardGrid>
        {audiences.map((audience) => <JourneyCard {...audience} />)}
      </CardGrid>
    </div>
  </section>

  <section id="senales" class="section-space scroll-mt-28 bg-aisa-sand">
    <div class="site-container">
      <div class="max-w-3xl">
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Señales orientativas
        </h2>
        <p class="mt-5 text-lg leading-8">
          Si una persona presenta alguna de las siguientes características y
          manifiesta dificultades de conducta, atención, aprendizaje o en la
          coordinación motora, es beneficioso que se asesoren con un Terapista
          Ocupacional formado en Integración Sensorial, para una eventual
          evaluación específica.
        </p>
      </div>

      <CardGrid>
        {
          signals.map((signal) => (
            <InfoCard
              title={signal.title}
              body={signal.body}
              tone="white"
              illustration={signal.illustration}
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <section id="familias" class="section-space scroll-mt-28 bg-white">
    <div
      class="site-container grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:gap-16"
    >
      <div>
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Para familias
        </h2>
        <p class="mt-5 text-lg leading-8">
          Nadie conoce a tu niño tan bien como vos. Si tu intuición te dice que
          hay algo que no está bien, confiá en tu percepción y consultá.
        </p>
      </div>
      <div class="rich-copy">
        <p class="mt-0">
          Si pensás que tu niño/a puede presentar dificultades de procesamiento
          sensorial, te sugerimos:
        </p>
        <ol class="grid list-decimal gap-3 pl-5 leading-7">
          <li>
            Hablar con tu pediatra o médico de cabecera sobre lo que observás.
          </li>
          <li>
            Si el examen clínico no explica esas conductas, solicitar una
            entrevista con un Terapista Ocupacional entrenado en Integración
            Sensorial para saber si hace falta una evaluación específica.
          </li>
          <li>
            Si recibe un diagnóstico de desorden de procesamiento sensorial,
            pedir una copia de los resultados de la evaluación.
          </li>
          <li>
            Verificar que el Terapista Ocupacional pueda acreditar su formación
            en Integración Sensorial y su capacitación continua.
          </li>
        </ol>
        <h3>Al comenzar un tratamiento</h3>
        <p>
          También es importante que la sala reúna condiciones adecuadas: un
          tamaño no menor a 4 por 4 metros, al menos dos puntos de suspensión,
          más de un modelo de equipamiento colgante y material terapéutico que
          ofrezca información de distintas modalidades sensoriales.
        </p>
      </div>
    </div>
  </section>

  <section id="docentes" class="section-space scroll-mt-28 bg-aisa-sand">
    <div
      class="site-container grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:gap-16"
    >
      <div>
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Para docentes y educadores
        </h2>
        <p class="mt-5 text-lg leading-8">
          La mirada del aula es fundamental para comprender cómo una persona
          participa y aprende en su entorno cotidiano.
        </p>
      </div>
      <div class="rich-copy">
        <p class="mt-0">
          Seguro tenés alumnos/as a los que les cuesta sostener la participación
          en clase o mantener la atención en lo relevante: pueden distraerse si
          un compañero/a habla, se mueve o se le acerca, o parecer abrumados por
          los sonidos y movimientos del aula.
        </p>
        <p>
          Estos signos pueden ser indicadores de dificultades en el
          procesamiento sensorial. Si reconocés tres o más, puede ser
          beneficioso conversar con la familia y sugerir una consulta con un
          Terapista Ocupacional formado en Integración Sensorial.
        </p>
        <ul class="grid list-disc gap-3 pl-5 leading-7">
          <li>Es demasiado activo, incapaz de frenarse o controlarse.</li>
          <li>Se mueve o hamaca en la silla y no puede permanecer quieto/a.</li>
          <li>Habla constantemente o interrumpe la clase.</li>
          <li>Nunca termina su tarea aun cuando puede hacer el trabajo.</li>
          <li>
            Tiene atención corta para su edad o dificultad para cambiar de tarea
            y seguir instrucciones.
          </li>
          <li>
            Parece débil, cansado/a o suele recostarse sobre el escritorio.
          </li>
          <li>
            Se cansa demasiado rápido al escribir o escribe con mucha presión.
          </li>
          <li>Parece más torpe y se lleva objetos o mobiliario por delante.</li>
          <li>Reacciona de manera inadecuada cuando un compañero/a lo toca.</li>
          <li>Sobre-reacciona a sonidos, luces, olores o gustos.</li>
          <li>
            Tiene un comportamiento explosivo o baja tolerancia a la
            frustración.
          </li>
          <li>No juega con otros niños/as o prefiere jugar en soledad.</li>
        </ul>
        <p>
          Comprender a los niños/as con dificultades en Integración Sensorial y
          mostrarte sensible y compasivo con ellos es un gran paso para
          ayudarles a aprender desde su propio estilo.
        </p>
      </div>
    </div>
  </section>

  <section id="salud" class="section-space scroll-mt-28 bg-aisa-sky-wash">
    <div
      class="site-container grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:gap-16"
    >
      <div>
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Para profesionales de la salud
        </h2>
        <p class="mt-5 text-lg leading-8">
          Una mirada compartida puede ayudar a ordenar la información funcional
          y definir cuándo conviene una consulta o una evaluación específica.
        </p>
      </div>
      <div class="rich-copy">
        <p class="mt-0">
          Las dificultades en el procesamiento sensorial pueden presentarse de
          forma aislada o junto con otras situaciones del desarrollo y la salud,
          como trastornos del espectro autista, déficit de atención, trastornos
          del aprendizaje, dispraxia, trastornos del lenguaje, síndromes
          genéticos, prematuridad o trastornos neuromotores.
        </p>
        <h3>¿En qué consiste la intervención?</h3>
        <div class="grid gap-5 sm:grid-cols-3">
          <article class="surface-card bg-white p-6">
            <h4 class="font-aisa-heading text-xl font-bold">
              Educación familiar
            </h4>
            <p class="mt-3 leading-7">
              Ayudar a la familia a entender el perfil sensorial y reconocer
              señales de advertencia favorece una mejor comunicación y
              participación.
            </p>
          </article>
          <article class="surface-card bg-white p-6">
            <h4 class="font-aisa-heading text-xl font-bold">
              Adaptación del ambiente
            </h4>
            <p class="mt-3 leading-7">
              Graduar la cantidad e intensidad de estímulos y crear espacios de
              calma puede favorecer la regulación en los contextos cotidianos.
            </p>
          </article>
          <article class="surface-card bg-white p-6">
            <h4 class="font-aisa-heading text-xl font-bold">
              Intervención directa
            </h4>
            <p class="mt-3 leading-7">
              La persona participa activamente en experiencias que acompañan la
              exploración, el juego y la resolución de problemas funcionales.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="proximos-pasos" class="section-space scroll-mt-28">
    <div class="site-container">
      <Callout
        title="¿Querés dar el próximo paso?"
        body="Si reconocés algunas de estas señales, conversá con tu equipo de salud y encontrá un Terapista Ocupacional formado en Integración Sensorial para saber si hace falta una evaluación específica."
        href="/buscar-profesional/#mapa"
        linkText="Encontrá un profesional"
        tone="leaf"
      />
    </div>
  </section>
</BaseLayout>
