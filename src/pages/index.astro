---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import JourneyCard from "../components/JourneyCard.astro";
import Callout from "../components/Callout.astro";
import CardGrid from "../components/design-system/CardGrid.astro";
import CardRail from "../components/design-system/CardRail.astro";
import SectionHeading from "../components/design-system/SectionHeading.astro";
import StackedCards from "../components/design-system/StackedCards.astro";
import heroImage from "../assets/hero-terapia.jpg";
import spaceImage from "../assets/espacio-terapeutico.jpg";

const pathways = [
  {
    title: "Entender con información clara",
    body: "Acercamos orientación general para reconocer cuándo una dificultad sensorial está afectando la vida cotidiana y cómo conversar con el equipo de salud o educativo.",
    href: "/familias-y-escuelas/",
    linkText: "Leer la guía",
  },
  {
    title: "Crecer con formación avalada",
    body: "Reunimos cursos, recorridos de certificación y criterios institucionales para acompañar el desarrollo de Terapistas Ocupacionales.",
    href: "/profesionales/formacion-y-cursos/",
    linkText: "Explorar la formación",
  },
  {
    title: "Conectar con la comunidad AISA",
    body: "Fortalecemos una red federal de profesionales especializados y preparamos un directorio público con información clara sobre sus certificaciones.",
    href: "/profesionales/",
    linkText: "Conocer la comunidad",
  },
];

const resources = [
  {
    title: "Qué es la Integración Sensorial",
    body: "Una explicación accesible sobre cómo recibimos, organizamos y usamos la información de los sentidos en la vida cotidiana.",
    href: "/familias-y-escuelas/#que-es",
    linkText: "Empezar por acá",
  },
  {
    title: "Cuándo conviene consultar",
    body: "Señales orientativas para observar con cuidado, sin convertirlas en diagnósticos ni reemplazar una evaluación profesional.",
    href: "/familias-y-escuelas/#proximos-pasos",
    linkText: "Ver próximos pasos",
  },
  {
    title: "Cursos avalados por AISA",
    body: "Programas organizados por nivel para que cada profesional encuentre con claridad el recorrido que necesita.",
    href: "/profesionales/formacion-y-cursos/#cursos",
    linkText: "Ver los cursos",
  },
  {
    title: "Certificación profesional",
    body: "Requisitos, niveles y proceso para solicitar el reconocimiento de tu formación en Integración Sensorial.",
    href: "/profesionales/certificacion/#requisitos",
    linkText: "Conocer el proceso",
  },
];
---

<BaseLayout
  title="AISA Argentina"
  description="Información, orientación y profesionales de Integración Sensorial en Argentina."
>
  <PageHero
    title="Fortaleciendo la Integración Sensorial en Argentina"
    lead="Promovemos la formación y el desarrollo profesional para acercar tratamientos de calidad a más personas y familias en todo el país."
    primaryHref="/buscar-profesional/"
    primaryLabel="Encontrar un profesional"
    secondaryHref="/acerca-de/"
    secondaryLabel="Conocé AISA"
    orbitImages={[heroImage, spaceImage]}
    fullHeight={true}
    landing={true}
    nextTone="sand"
  />

  <section class="section-space bg-aisa-sand">
    <div class="site-container">
      <SectionHeading
        title="Cómo podemos acompañarte"
        body="Tres puertas de entrada para encontrar orientación, formación y comunidad desde un mismo lugar."
      />
      <CardGrid>
        <JourneyCard
          number="01"
          title="Familias y escuelas"
          body="Información clara para comprender señales, preparar una consulta y acompañar la participación cotidiana."
          href="/familias-y-escuelas/"
          linkText="Buscá orientación"
          tone="sky"
        />
        <JourneyCard
          number="02"
          title="Profesionales"
          body="Cursos avalados, certificación y recursos para seguir desarrollándote en Integración Sensorial."
          href="/profesionales/"
          linkText="Conocé los recorridos"
          tone="white"
        />
        <JourneyCard
          number="03"
          title="Comunidad AISA"
          body="Una red federal que comparte conocimiento, sostiene criterios de calidad y amplía el acceso a profesionales especializados."
          href="/profesionales/#solicitud"
          linkText="Asociate a AISA"
          tone="leaf"
          featured={true}
        />
      </CardGrid>
    </div>
  </section>

  <StackedCards
    title="Un recorrido que transforma información en acción"
    body="Cada experiencia del sitio está pensada para que el siguiente paso sea fácil de reconocer, tanto para la comunidad como para profesionales."
    items={pathways}
  />

  <CardRail
    title="Explorá a tu ritmo"
    body="Recursos concretos para llegar directamente a la información que necesitás."
    items={resources}
  />

  <section class="section-space bg-white">
    <div class="site-container">
      <Callout
        title="Encontrá orientación profesional cerca tuyo"
        body="Explorá profesionales por provincia y localidad, consultá el estado de sus certificaciones y encontrá opciones cercanas desde el mapa."
        href="/buscar-profesional/"
        linkText="Explorar el directorio"
        tone="green"
      />
    </div>
  </section>
</BaseLayout>
