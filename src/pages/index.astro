---

<BaseLayout
  title="AISA Argentina"
  description="Información, orientación y profesionales de Integración Sensorial en Argentina."
>
  <PageHero
    title="Fortaleciendo la Integración Sensorial en Argentina"
    lead="Promovemos la formación y el desarrollo profesional para acercar tratamientos de calidad a más personas y familias en todo el país."
    primaryHref="/buscar-profesional/"
    primaryLabel="Encontrá un profesional"
    secondaryHref="/acerca-de/"
    secondaryLabel="Conocé AISA"
    orbitImages={[heroImage, spaceImage]}
    fullHeight={true}
    landing={true}
    nextTone="sand"
  />

  <section class="section-space bg-aisa-sand">
    <div class="site-container">
      <SectionHeading title="¿Cómo podemos ayudarte?" body="" />
      <CardGrid>
        <JourneyCard
          eyebrow="Información"
          title="Familias y escuelas"
          body="Información para comprender señales, prepararte para una consulta y acompañar la participación cotidiana."
          href="/familias-y-escuelas/"
          linkText="Buscá orientación"
          tone="sky"
        />
        <JourneyCard
          eyebrow="Cursos"
          title="Profesionales"
          body="Cursos avalados y material para seguir desarrollándote en Integración Sensorial."
          href="/profesionales/"
          linkText="Conocé los cursos"
          tone="white"
        />
        <JourneyCard
          eyebrow="Certificaciones"
          title="Comunidad AISA"
          body="Una red que comparte conocimiento, sostiene criterios de calidad y amplía el acceso a profesionales especializados con."
          href="/profesionales/#solicitud"
          linkText="Asociate con AISA"
          tone="leaf"
          featured={true}
        />
      </CardGrid>
    </div>
  </section>

  <StackedCards
    title="Encontrá la ayuda que necesitás"
    body="Mantenemos un directorio actualizado con profesionales especializados en Integración Sensorial que pueden responder tus preguntas."
    items={pathways}
  />

  <!-- <CardRail
    title="Explorá a tu ritmo"
    body="Recursos concretos para llegar directamente a la información que necesitás."
    items={resources}
  /> -->

  <section class="section-space bg-white">
    <div class="site-container">
      <Callout
        title="Encontrá orientación profesional"
        body="Ponete en contacto con profesionales cerca tuyo usando nuestro mapa."
        href="/buscar-profesional/#mapa"
        linkText="Explorá el mapa"
        tone="green"
      />
    </div>
  </section>
</BaseLayout>
