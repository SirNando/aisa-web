---
import BaseLayout from "../layouts/BaseLayout.astro";

// The QR on each Certificado leads to /verificar/<token>; public/_redirects serves this page there.
const platformApiUrl = import.meta.env.PUBLIC_DIRECTORY_API_URL.replace(/\/+$/u, "");
---

<BaseLayout
  title="Verificar Certificado"
  description="Consultá si un Certificado de AISA sigue siendo válido."
  noindex={true}
>
  <section
    class="certificate-verification section-space"
    data-certificate-verification
    data-platform-api-url={platformApiUrl}
    data-status="loading"
    aria-busy="true"
  >
    <div class="site-container">
      <section class="verification-card" aria-labelledby="certificate-verification-title">
        <div class="verification-icon" data-verification-icon aria-hidden="true">…</div>
        <h1 id="certificate-verification-title" data-verification-title>Verificando el Certificado</h1>
        <p data-verification-message aria-live="polite">
          Estamos consultando el estado del Certificado en AISA.
        </p>
        <dl class="verification-details" data-verification-details hidden>
          <div>
            <dt>Nombres y apellidos</dt>
            <dd data-field="fullName"></dd>
          </div>
          <div>
            <dt>Nivel</dt>
            <dd data-field="levelLabel"></dd>
          </div>
          <div data-member-number-row>
            <dt>Número de socio</dt>
            <dd data-field="memberNumber"></dd>
          </div>
          <div>
            <dt>Generado el</dt>
            <dd data-field="generatedOn"></dd>
          </div>
          <div>
            <dt>Válido hasta</dt>
            <dd data-field="validUntil"></dd>
          </div>
          <div>
            <dt>Estado</dt>
            <dd data-field="status"></dd>
          </div>
        </dl>
        <p class="verification-note">
          El estado se consulta en el momento: un Certificado vale sólo hasta la
          fecha indicada y mientras la Certificación siga activa.
        </p>
        <div class="verification-actions">
          <a class="button-quiet" href="/">Volver al inicio</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    certificateVerificationUrl,
    parseCertificateVerification,
    verificationTokenFromPath,
    type CertificateVerificationView,
  } from "../lib/certificateVerification";

  type VerificationStatus = "valid" | "invalid" | "not_found" | "error";
  let cleanupVerification: (() => void) | undefined;

  const NOT_FOUND_TITLE = "Este Certificado no existe o ya no es válido";

  const initialiseVerification = () => {
    const root = document.querySelector<HTMLElement>("[data-certificate-verification]");
    if (!root || root.dataset.initialised === "true") return;
    root.dataset.initialised = "true";

    const title = root.querySelector<HTMLElement>("[data-verification-title]");
    const message = root.querySelector<HTMLElement>("[data-verification-message]");
    const icon = root.querySelector<HTMLElement>("[data-verification-icon]");
    const details = root.querySelector<HTMLElement>("[data-verification-details]");
    const memberNumberRow = root.querySelector<HTMLElement>("[data-member-number-row]");
    const apiUrl = root.dataset.platformApiUrl ?? "";
    const request = new AbortController();

    const setField = (name: string, value: string) => {
      const field = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
      if (field) field.textContent = value;
    };

    const render = (status: VerificationStatus, certificate?: CertificateVerificationView) => {
      root.dataset.status = status;
      root.setAttribute("aria-busy", "false");
      if (icon) icon.textContent = status === "valid" ? "✓" : status === "error" ? "!" : "×";
      if (title) {
        title.textContent = status === "valid"
          ? "Certificado válido"
          : status === "invalid"
            ? "Certificado no válido"
            : status === "not_found"
              ? NOT_FOUND_TITLE
              : "No pudimos verificar el Certificado";
      }
      if (message) {
        message.textContent = status === "valid"
          ? "La Certificación de este Certificado está activa en AISA."
          : status === "invalid"
            ? "La Certificación de este Certificado no está activa en este momento."
            : status === "not_found"
              ? "Revisá que el enlace o el código QR sea el que figura en el Certificado."
              : "Intentá nuevamente en unos minutos.";
      }
      if (details) details.hidden = !certificate;
      if (!certificate) return;
      setField("fullName", certificate.fullName);
      setField("levelLabel", certificate.levelLabel);
      setField("memberNumber", certificate.memberNumber);
      setField("generatedOn", certificate.generatedOn);
      setField("validUntil", certificate.validUntil);
      setField("status", certificate.valid ? "Válido" : "No válido");
      if (memberNumberRow) memberNumberRow.hidden = !certificate.memberNumber;
    };

    const verify = async () => {
      const token = verificationTokenFromPath(window.location.pathname);
      if (!token) {
        render("not_found");
        return;
      }
      try {
        const response = await fetch(certificateVerificationUrl(apiUrl, token), {
          cache: "no-store",
          headers: { Accept: "application/json" },
          credentials: "omit",
          signal: request.signal,
        });
        if (response.status === 404) {
          render("not_found");
          return;
        }
        if (!response.ok) throw new Error("Verification unavailable");
        const certificate = parseCertificateVerification(await response.json());
        if (!certificate) throw new Error("Malformed verification");
        render(certificate.valid ? "valid" : "invalid", certificate);
      } catch {
        if (request.signal.aborted) return;
        render("error");
      }
    };

    void verify();
    cleanupVerification = () => {
      request.abort();
      cleanupVerification = undefined;
    };
  };

  document.addEventListener("astro:page-load", initialiseVerification);
  document.addEventListener("astro:before-swap", () => cleanupVerification?.());
  initialiseVerification();
</script>

<style>
  .certificate-verification {
    min-height: min(75vh, 48rem);
    background: linear-gradient(180deg, var(--color-leaf-wash), var(--color-white));
  }

  .verification-card {
    width: min(100%, 42rem);
    margin-inline: auto;
    padding: clamp(2rem, 7vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-raised);
    text-align: center;
  }

  .verification-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-leaf-wash);
    color: var(--color-aisa-green-dark);
    font-size: 2rem;
    font-weight: 800;
  }

  [data-status="valid"] .verification-icon {
    background: var(--color-aisa-green);
    color: var(--color-on-primary);
  }

  [data-status="invalid"] .verification-icon,
  [data-status="not_found"] .verification-icon,
  [data-status="error"] .verification-icon {
    background: color-mix(in srgb, var(--color-danger) 9%, var(--color-white));
    color: var(--color-danger);
  }

  .verification-card h1 {
    font-size: var(--text-section-title);
    line-height: 1.08;
  }

  .verification-card > p {
    max-width: 34rem;
    margin: 1rem auto 0;
    color: var(--color-muted);
  }

  .verification-details {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    text-align: start;
  }

  .verification-details > div {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .verification-details > div[hidden] {
    display: none;
  }

  .verification-details dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .verification-details dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .verification-note {
    font-size: var(--text-sm);
  }

  .verification-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 36rem) {
    .verification-details > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .verification-actions > * {
      width: 100%;
      justify-content: center;
    }
  }
</style>
