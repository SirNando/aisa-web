---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import StatusNotice from "../components/StatusNotice.astro";
import DirectoryPrototype from "../components/DirectoryPrototype.astro";
import heroImage from "../assets/hero-terapia.jpg";
import spaceImage from "../assets/espacio-terapeutico.jpg";
---

<BaseLayout
  title="Buscar profesional"
  description="Prototipo del futuro directorio AISA para buscar profesionales por ubicación y estado de certificación."
  noindex={true}
>
  <PageHero
    eyebrow="Directorio profesional · Prototipo"
    title="Probá cómo será buscar un profesional."
    lead="Esta página demuestra la experiencia de búsqueda con seis perfiles completamente ficticios. No contiene profesionales reales, datos personales ni medios de contacto."
    orbitImages={[spaceImage, heroImage]}
    compact={true}
  />

  <section class="bg-white py-8">
    <div class="site-container">
      <StatusNotice title="Directorio de demostración">
        Todos los nombres y resultados son ficticios. La próxima iteración definirá la fuente de datos, el consentimiento de publicación, la normalización de ubicaciones y la actualización de estados.
      </StatusNotice>
    </div>
  </section>

  <section class="section-space">
    <div class="site-container">
      <DirectoryPrototype />
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="site-container max-w-4xl text-center">
      <p class="eyebrow">¿Necesitás orientación hoy?</p>
      <h2 class="mt-4 font-aisa-heading text-3xl font-bold text-aisa-ink">
        Este prototipo todavía no permite contactar profesionales
      </h2>
      <p class="mx-auto mt-4 max-w-2xl leading-7">
        Podés escribirle a AISA para hacer una consulta general mientras se prepara el directorio definitivo.
      </p>
      <a
        class="button-secondary mt-7"
        href="mailto:integracion.sensorialargentina@gmail.com?subject=Consulta%20sobre%20el%20directorio%20de%20profesionales"
      >
        Consultar a AISA por correo
      </a>
    </div>
  </section>
</BaseLayout>
