---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProfessionalDirectory from "../components/ProfessionalDirectory.astro";
import { heroMedia } from "../data/siteMedia";
---

<BaseLayout
  title="Buscar profesional"
  description="Directorio AISA para buscar profesionales por nombre, ubicación y cercanía."
>
  <PageHero
    title="Encontrá profesionales desde el mapa."
    lead="Buscá por nombre, provincia o localidad y usá tu ubicación para encontrar la opción más cercana."
    orbitImages={heroMedia.search}
    illustrations={[
      { kind: "balloon-plane", tone: "sky" },
      { kind: "tree", tone: "leaf" },
      { kind: "kite", tone: "sand" },
    ]}
    imageAlt="Sala preparada para actividades de movimiento y participación."
    fullHeight={true}
    nextTone="mist"
  />

  <section class="section-space">
    <div class="site-container">
      <ProfessionalDirectory />
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="site-container max-w-4xl text-center">
      <h2 class="font-aisa-heading text-3xl font-bold text-aisa-ink">
        ¿Necesitás ayuda para orientar tu búsqueda?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl leading-7">
        Escribile a AISA para hacer una consulta general sobre el directorio.
      </p>
      <a
        class="button-secondary mt-7"
        href="mailto:integracion.sensorialargentina@gmail.com?subject=Consulta%20sobre%20el%20directorio%20de%20profesionales"
      >
        Consultar a AISA por correo
      </a>
    </div>
  </section>
</BaseLayout>
