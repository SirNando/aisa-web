---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import { heroMedia } from "../data/siteMedia";
import sabrinaBlanco from "../assets/equipo/sabrina-blanco.jpg";
import alejandraUberti from "../assets/equipo/alejandra-uberti.png";
import patriciaRodriguez from "../assets/equipo/patricia-rodriguez.jpg";
import mariaFernandezTorres from "../assets/equipo/maria-fernandez-torres.png";
import mariaRomero from "../assets/equipo/maria-romero.jpg";
import antonellaFrediani from "../assets/equipo/antonella-frediani.jpg";
import lucianaDassoSuffern from "../assets/equipo/luciana-dasso-suffern.jpg";
import luciaSpringer from "../assets/equipo/lucia-springer.jpg";
import nataliaPeralta from "../assets/equipo/natalia-peralta.png";
import erikaGarcia from "../assets/equipo/erika-garcia.png";
import ceciliaLatorre from "../assets/equipo/cecilia-latorre.png";

const board = [
  { name: "Lic. Sabrina Blanco", role: "Presidente", area: "Directorio", image: sabrinaBlanco },
  { name: "Lic. Alejandra Uberti", role: "Vicepresidente", area: "Directorio", image: alejandraUberti },
  { name: "Lic. Patricia Rodríguez", role: "Secretaria", area: "Directorio", image: patriciaRodriguez },
  { name: "Lic. María Fernandez Torres", role: "Tesorera", area: "Directorio", image: mariaFernandezTorres },
  { name: "Lic. María de Los Ángeles Romero", role: "1er Vocal", area: "Directorio", image: mariaRomero },
  { name: "Lic. Antonella Frediani", role: "2do Vocal", area: "Directorio", image: antonellaFrediani },
  { name: "Lic. Luciana Dasso Suffern", role: "1er Vocal suplente", area: "Directorio", image: lucianaDassoSuffern },
  { name: "Lic. Lucía Springer", role: "2do Vocal suplente", area: "Directorio", image: luciaSpringer },
  { name: "Lic. Natalia Peralta", role: "Órgano de Fiscalización", area: "Fiscalización", image: nataliaPeralta },
  { name: "Lic. Erika García", role: "Órgano de Fiscalización", area: "Fiscalización", image: erikaGarcia },
  { name: "Lic. Cecilia Latorre", role: "Órgano de fiscalización suplente", area: "Fiscalización", image: ceciliaLatorre },
];

const honoraryMembers = [
  "Mgter. Lic. María Rosa Nico, OTR – BCP",
  "Mgter. Lic. Julia Salzman, MSc, OTR/L.",
  "Dr. Gustavo Reinoso, OTR/L.",
  "Dra. Erna Blanche, OTR, FAOTA.",
  "Lic. Gloria Chumbita",
];

const pillars = [
  {
    number: "01",
    title: "Difusión",
    body: "Acercamos la teoría de Integración Sensorial desarrollada por la Dra. Jean Ayres a profesionales y a la comunidad.",
  },
  {
    number: "02",
    title: "Formación continua",
    body: "Propiciamos espacios de aprendizaje y encuentro que acompañan el desarrollo profesional en todo el país.",
  },
  {
    number: "03",
    title: "Conocimiento",
    body: "Promovemos la producción y circulación de conocimiento para fortalecer la disciplina y su práctica.",
  },
  {
    number: "04",
    title: "Calidad",
    body: "Trabajamos para sostener la calidad de los servicios brindados en Integración Sensorial.",
  },
];
---

<BaseLayout
  title="Acerca de AISA"
  description="Conocé la misión, los objetivos y la Comisión Directiva 2025–2027 de la Asociación de Integración Sensorial Argentina."
>
  <PageHero
    title="Una asociación que conecta, forma y hace crecer la Integración Sensorial."
    lead="Somos una asociación civil sin fines de lucro formada por Terapistas Ocupacionales argentinos especializados en Integración Sensorial."
    primaryHref="#mision"
    primaryLabel="Conocé nuestra misión"
    secondaryHref="#equipo"
    secondaryLabel="Conocé al equipo"
    orbitImages={heroMedia.about}
    illustrations={[
      { kind: "tree", tone: "leaf" },
      { kind: "puzzle", tone: "sky" },
      { kind: "balloon-plane", tone: "sand" },
    ]}
    imageAlt="Familia compartiendo un momento de juego en un espacio terapéutico."
    fullHeight={true}
    nextTone="white"
  />

  <section id="mision" class="section-space scroll-mt-28 bg-white">
    <div class="site-container grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:gap-16">
      <div>
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Quiénes somos: una comunidad federal comprometida con la práctica.
        </h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="organic-panel rounded-[var(--radius-card)] bg-aisa-sky-wash p-6 sm:p-8">
          <p class="inline-flex rounded-full bg-white/70 px-3 py-1 text-sm font-semibold text-aisa-sky-strong">
            Nuestra misión
          </p>
          <p class="mt-4 text-lg leading-8 text-aisa-ink">
            Nucleamos terapistas ocupacionales de la República Argentina
            especializados en Integración Sensorial para difundir la teoría
            desarrollada por la Dra. Jean Ayres y propiciar espacios de
            aprendizaje y encuentro.
          </p>
        </article>
        <article class="organic-panel rounded-[var(--radius-card)] bg-aisa-leaf-wash p-6 sm:p-8">
          <p class="inline-flex rounded-full bg-white/70 px-3 py-1 text-sm font-semibold text-aisa-green-dark">
            Nuestro objetivo
          </p>
          <p class="mt-4 text-lg leading-8 text-aisa-ink">
            Consolidar una red profesional que garantice la difusión, la
            formación continua, la producción de conocimiento y la calidad de
            los servicios de Integración Sensorial brindados en el país.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="site-container">
      <div class="max-w-3xl">
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Cómo trabajamos: cuatro compromisos que orientan nuestra tarea.
        </h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((pillar) => (
            <article class="surface-card flex h-full flex-col p-6 sm:p-7">
              <span class="font-aisa-heading text-sm font-extrabold text-aisa-green-strong">
                {pillar.number}
              </span>
              <h3 class="mt-7 font-aisa-heading text-2xl font-bold text-aisa-ink">
                {pillar.title}
              </h3>
              <p class="mt-3 leading-7 text-aisa-body">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="equipo" class="section-space scroll-mt-28 bg-white">
    <div class="site-container">
      <div class="grid gap-6 lg:grid-cols-[1fr_.65fr] lg:items-end">
        <div>
          <h2 class="font-aisa-heading text-aisa-section-title font-bold">
            Las personas detrás de AISA: Comisión Directiva 2025–2027
          </h2>
        </div>
        <p class="max-w-xl text-lg leading-8 lg:justify-self-end">
          Un equipo de profesionales que conduce, organiza y acompaña el trabajo
          institucional de la asociación.
        </p>
      </div>

      <div class="mt-10 grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          board.map((member) => (
            <article class="group">
              <div class="aspect-[4/4.35] overflow-hidden rounded-[var(--radius-card)] bg-aisa-mist">
                <Image
                  src={member.image}
                  alt={`Retrato de ${member.name}`}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 1280px) 21vw, (min-width: 1024px) 28vw, (min-width: 640px) 45vw, 90vw"
                  class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.025]"
                  loading="lazy"
                />
              </div>
              <div class="pt-4">
                <p class="inline-flex rounded-full bg-aisa-sky-wash px-3 py-1 text-xs font-semibold text-aisa-sky-strong">
                  {member.area}
                </p>
                <h3 class="mt-2 font-aisa-heading text-xl font-bold text-aisa-ink">
                  {member.name}
                </h3>
                <p class="mt-1 text-sm leading-6 text-aisa-body">{member.role}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-space bg-aisa-sand">
    <div class="site-container grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:gap-16">
      <div>
        <h2 class="font-aisa-heading text-aisa-section-title font-bold">
          Nuestra historia compartida con los socios honoríficos
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-8">
          AISA reconoce a quienes han realizado aportes significativos al
          desarrollo y la difusión de la Integración Sensorial.
        </p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          honoraryMembers.map((member) => (
            <li class="surface-card flex min-h-24 items-center gap-4 p-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-aisa-leaf-wash font-aisa-heading font-bold text-aisa-green-dark" aria-hidden="true">
                A
              </span>
              <span class="font-semibold leading-6 text-aisa-ink">{member}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-space bg-white">
    <div class="site-container">
      <Callout
        title="Formá parte de la comunidad AISA"
        body="Sumate a una red de Terapistas Ocupacionales comprometida con la formación continua y la calidad de la práctica en Integración Sensorial."
        href="/profesionales/#solicitud"
        linkText="Quiero asociarme"
        tone="leaf"
        motionKey="about-membership-callout"
      />
    </div>
  </section>
</BaseLayout>
