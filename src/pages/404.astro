---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { heroMedia } from "../data/siteMedia";
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe o cambió de ubicación."
  noindex={true}
>
  <PageHero
    title="Error 404: no encontramos esa página."
    lead="Puede haber cambiado de lugar. Volvé al inicio o elegí una de las tareas principales."
    primaryHref="/"
    primaryLabel="Volver al inicio"
    secondaryHref="/contacto/"
    secondaryLabel="Contactar a AISA"
    fullHeight={true}
    orbitImages={heroMedia.notFound}
    illustrations={[
      { kind: "balloon-plane", tone: "sky" },
      { kind: "cloud", tone: "inverse" },
      { kind: "puzzle", tone: "sand" },
    ]}
    imageAlt="Niño explorando bloques de colores durante el juego."
    nextTone="mist"
  />
</BaseLayout>
