---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import heroImage from "../assets/hero-terapia.jpg";
import spaceImage from "../assets/espacio-terapeutico.jpg";
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe o cambió de ubicación."
  noindex={true}
>
  <PageHero
    title="Error 404: no encontramos esa página."
    lead="Puede haber cambiado de lugar. Volvé al inicio o elegí una de las tareas principales."
    primaryHref="/"
    primaryLabel="Volver al inicio"
    secondaryHref="/contacto/"
    secondaryLabel="Contactar a AISA"
    fullHeight={true}
    orbitImages={[heroImage, spaceImage]}
    nextTone="mist"
  />
</BaseLayout>
