{
  "name": "aisa-argentina-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs preview",
    "deploy": "npm run build && wrangler deploy --env \"\"",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
