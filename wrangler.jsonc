{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aisa-web",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "aisa-web.nandinc.dev", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_DIRECTORY_API_URL": "https://aisa-plataforma.nandinc.dev"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {
      "name": "aisa-web-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "aisa-web-preview.nandinc.dev", "custom_domain": true }
      ],
      "vars": {
        "PUBLIC_DIRECTORY_API_URL": "https://aisa-plataforma-preview.nandinc.dev"
      }
    }
  }
}
